+++ b/digest_request_uri_test.go
@@ -0,0 +1,67 @@
+package sipgo
+
+import (
+	"context"
+	"crypto/md5"
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/emiago/sipgo/sip"
+	"github.com/icholy/digest"
+	"github.com/stretchr/testify/require"
+)
+
+func TestDigestUsesCompleteRequestURI(t *testing.T) {
+	for _, status := range []int{401, 407} {
+		for _, dialog := range []bool{false, true} {
+			t.Run(fmt.Sprintf("%d/dialog=%t", status, dialog), func(t *testing.T) {
+				const uri = "sip:alice@example.test:5070;transport=tcp;user=phone?subject=hello"
+				const challenge = `Digest realm="carrier", nonce="test-nonce", algorithm=MD5, qop="auth"`
+				credentialHeader, challengeHeader := "Authorization", "WWW-Authenticate"
+				if status == 407 {
+					credentialHeader, challengeHeader = "Proxy-Authorization", "Proxy-Authenticate"
+				}
+				attempts := 0
+				hash := func(value string) string { return fmt.Sprintf("%x", md5.Sum([]byte(value))) }
+				client := testClient(t, func(req *sip.Request) *sip.Response {
+					attempts++
+					actualURI := strings.Fields(req.StartLine())[1]
+					require.Equal(t, uri, actualURI)
+					credentials := req.GetHeader(credentialHeader)
+					if credentials == nil {
+						response := sip.NewResponseFromRequest(req, status, "Authenticate", nil)
+						response.AppendHeader(sip.NewHeader(challengeHeader, challenge))
+						return response
+					}
+					parsed, err := digest.ParseCredentials(credentials.Value())
+					require.NoError(t, err)
+					require.Equal(t, actualURI, parsed.URI, "digest uri must match the complete wire request target")
+					expected := hash(fmt.Sprintf("%s:test-nonce:%08x:%s:auth:%s", hash("alice:carrier:secret"), parsed.Nc, parsed.Cnonce, hash(string(req.Method)+":"+actualURI)))
+					require.Equal(t, expected, parsed.Response, "digest must hash the complete wire request target")
+					response := sip.NewResponseFromRequest(req, 200, "OK", nil)
+					response.To().Params.Add("tag", "carrier")
+					response.AppendHeader(sip.NewHeader("Contact", "<sip:carrier@example.test>"))
+					return response
+				})
+				var target sip.Uri
+				require.NoError(t, sip.ParseUri(uri, &target))
+				if dialog {
+					ua := &DialogUA{Client: client}
+					session, err := ua.Invite(context.Background(), target, nil)
+					require.NoError(t, err)
+					require.NoError(t, session.WaitAnswer(context.Background(), AnswerOptions{Username: "alice", Password: "secret"}))
+				} else {
+					request := sip.NewRequest(sip.OPTIONS, target)
+					response, err := client.Do(context.Background(), request)
+					require.NoError(t, err)
+					require.Equal(t, status, response.StatusCode)
+					accepted, err := client.DoDigestAuth(context.Background(), request, response, DigestAuth{Username: "alice", Password: "secret"})
+					require.NoError(t, err)
+					require.Equal(t, 200, accepted.StatusCode)
+				}
+				require.Equal(t, 2, attempts)
+			})
+		}
+	}
+}
diff --git a/sip/portable/README.md b/sip/portable/README.md
new file mode 100644
index 0000000..2d329dc
--- /dev/null
+++ b/sip/portable/README.md
@@ -0,0 +1,86 @@
+# Portable protocol values
+
+This experimental package exposes native SIP transaction/dialog decisions as
+serializable values. The driver supplies event time in milliseconds and all
+random identifiers. Reducers clone their inputs and return values plus ordered
+effects; they never open connections, start timers, read entropy, wait on
+channels, call applications or access storage. `Message` contains immutable wire
+bytes and separately observed transport/source/destination metadata.
+
+Commit the resulting state and effects together before interpreting effects.
+Timer notifications carry the exact saved name/generation and may be duplicated;
+the saved absolute deadline is authoritative. Delivery results are later inputs.
+An effect is an instruction, not evidence of a successful socket write. Storage
+fences, effect IDs, exclusive dispatch, uncertainty, authorization and bounded
+retention belong to the driver. A transaction key locates a candidate; full native
+origin identity matching remains mandatory.
+
+Four transaction families use explicit phases. Dialog values retain directional
+identity, independent sequence spaces, fixed route sets, accepted target,
+pending INVITE/offer/ACK procedures and absolute successful-final ACK deadlines.
+Create a separate dialog value for each remote-tag fork. The transaction reducer
+reports every accepted-transaction 2xx; the driver dispatches it to that child.
+Transaction presentation effects must pass dialog admission before application
+execution. A dialog `respond` effect is submitted to its server transaction, not
+written directly; `start_transaction` creates a client transaction. Direct `send`
+is reserved for stateless ACK or a transaction-owned wire effect.
+
+The legacy goroutine/timer API remains unchanged in this intermediate extraction.
+It must never run beside a portable FSM for the same transaction/dialog. Migrating
+that convenience driver onto these reducers remains separate work. The package
+does not itself provide a Redis runtime or qualify unsupported SIP extensions.
+
+Deliberate corrections relative to the legacy storage/action implementation are
+explicit non-INVITE E/F/K timers, a fixed TU ACK deadline and exponentially capped
+TU retransmission interval, no sleeping ACK action, and Accepted-state retention
+after transport failure. These are covered by deterministic event traces. Strict
+and loose route construction use the complete persisted route set. PRACK/session
+timers and proxy forking policy are outside this package's supported profile.
+
+## Driver API
+
+- `NewTransaction` and `StepTransaction` implement the four transaction families.
+  `RequestCancel` records client INVITE cancellation, deferring its single
+  `start_transaction` effect until a provisional response permits CANCEL.
+  Emitting that CANCEL also commits a fixed `64*T1` cancellation watchdog for
+  the original INVITE, following the UAC-core recommendation in
+  [RFC 3261 section 9.1](https://www.rfc-editor.org/rfc/rfc3261#section-9.1).
+  Repeated cancellation/provisional input cannot extend it; an INVITE final or
+  termination stops it. CANCEL's own transaction remains independent.
+  An elapsed B/F/H terminal deadline takes precedence over a delayed A/E/G
+  retransmission notification, so scheduler recovery cannot emit fresh traffic
+  after that procedure's original absolute timeout.
+- `StepServerCancel` returns both INVITE and CANCEL transaction values. Commit
+  them together; retain CANCEL's own non-INVITE replay state independently of
+  INVITE retirement. Later CANCEL duplicates can use `StepTransaction` on the
+  retained CANCEL value without the original INVITE being alive.
+- `NewDialog` creates one tagged branch. `StepDialog` owns its local/remote
+  sequence allocation, target refresh, fixed routes and successful-INVITE ACK
+  procedure. `DialogCancel` marks the branch for cleanup; it does not create a
+  second CANCEL alongside the client transaction's cancellation procedure.
+- `BuildInitialRequest`, `BuildResponseWithHeaders` and
+  `BuildDialogRequestWithHeaders` accept explicit committed identities and
+  application content. Native identity/routing/framing headers cannot be
+  overridden by the arbitrary header list. Initial From/To may be supplied in
+  structured fields or once in the header list; a supplied From tag must match
+  the reserved native tag. Dialog response Contact is an explicit URI or name-addr
+  argument; bare URI parameters stay inside the URI rather than becoming header
+  parameters.
+  Successful REGISTER response Contacts are registration-policy content: validated
+  ordered Contact headers (including expires parameters) come from the application
+  header list, and the builder never adds its own dialog Contact to REGISTER.
+- `BuildDigestRetry` requires the original complete URI, explicit cnonce/count
+  and new branch. It is a transient credential-executor helper, not a durable
+  reducer input. Password is excluded from JSON encoding and is never retained
+  in transaction/dialog state.
+
+`Dialog.Retiring` is monotonic. A late successful re-INVITE or its ACK cannot
+reopen a dialog after local termination. `LocalBye` retains the one allocated
+request; its final response ends the dialog even on failure. Native completion
+and wire-result certainty remain separate from application acceptance.
+
+Validate hydrated values before interpreting effects. Unknown versions, phases,
+transaction keys or transport profiles fail rather than calling initialization.
+The driver supplies bounded storage/concurrency and dispatches transaction
+effects to the correct dialog branch. This package has no per-dialog actor,
+timer goroutine or persistence implementation.
diff --git a/sip/portable/build.go b/sip/portable/build.go
new file mode 100644
index 0000000..60d5804
--- /dev/null
+++ b/sip/portable/build.go
@@ -0,0 +1,257 @@
+package portable
+
+import (
+	"bytes"
+	"errors"
+	"math"
+	"net"
+	"strconv"
+	"strings"
+
+	"github.com/emiago/sipgo/sip"
+)
+
+// Header preserves application header order and repeated values. Protocol-owned
+// identity, routing and framing headers cannot be overridden through this list.
+type Header struct {
+	Name  string `json:"name"`
+	Value string `json:"value"`
+}
+
+// InitialRequest supplies every random/native identity explicitly. The driver
+// must commit the resulting message before interpreting a send effect.
+type InitialRequest struct {
+	Method                        sip.RequestMethod
+	URI, From, To                 string
+	CallID, LocalTag, Branch      string
+	CSeq                          uint32
+	Advertise, Contact, Transport string
+	Headers                       []Header
+	Body                          []byte
+}
+
+func BuildInitialRequest(in InitialRequest) (Message, error) {
+	if !validToken(string(in.Method)) || in.Method == sip.ACK || in.Method == sip.CANCEL || in.CSeq > math.MaxInt32 ||
+		in.CallID == "" || !validToken(in.LocalTag) || !validBranch(in.Branch) || strings.ContainsAny(in.CallID, " \t\r\n\x00") || strings.ContainsAny(in.URI, "\r\n\x00") {
+		return Message{}, errors.New("explicit initial method, Call-ID, tag, branch and CSeq required")
+	}
+	if in.Transport != "udp" && in.Transport != "tcp" && in.Transport != "tls" {
+		return Message{}, errors.New("observed transport required")
+	}
+	var target sip.Uri
+	if err := sip.ParseUri(in.URI, &target); err != nil || target.Host == "" {
+		return Message{}, errors.New("invalid initial Request-URI")
+	}
+	if target.IsEncrypted() && in.Transport != "tls" {
+		return Message{}, errors.New("SIPS requires TLS")
+	}
+	fromText, toText := in.From, in.To
+	remaining := make([]Header, 0, len(in.Headers))
+	for _, h := range in.Headers {
+		switch strings.ToLower(h.Name) {
+		case "from", "f":
+			if fromText != "" {
+				return Message{}, errors.New("duplicate initial From")
+			}
+			fromText = h.Value
+		case "to", "t":
+			if toText != "" {
+				return Message{}, errors.New("duplicate initial To")
+			}
+			toText = h.Value
+		default:
+			remaining = append(remaining, h)
+		}
+	}
+	if fromText == "" {
+		fromText = "<sip:sipbridge@" + in.Advertise + ">"
+	}
+	if toText == "" {
+		toText = "<" + target.String() + ">"
+	}
+	from, err := parseAddress(fromText)
+	if err != nil {
+		return Message{}, err
+	}
+	if existing := tag(from.Params); existing != "" && existing != in.LocalTag {
+		return Message{}, errors.New("application From conflicts with native tag")
+	}
+	from.Params.Add("tag", in.LocalTag)
+	to, err := parseAddress(toText)
+	if err != nil {
+		return Message{}, err
+	}
+	if tag(to.Params) != "" {
+		return Message{}, errors.New("initial To must not claim a dialog")
+	}
+	r := sip.NewRequest(in.Method, target)
+	r.AppendHeader(&sip.FromHeader{DisplayName: from.DisplayName, Address: from.Address, Params: from.Params})
+	r.AppendHeader(&sip.ToHeader{DisplayName: to.DisplayName, Address: to.Address, Params: to.Params})
+	id := sip.CallIDHeader(in.CallID)
+	r.AppendHeader(&id)
+	r.AppendHeader(&sip.CSeqHeader{SeqNo: in.CSeq, MethodName: in.Method})
+	fwd := sip.MaxForwardsHeader(70)
+	r.AppendHeader(&fwd)
+	via, err := buildVia(in.Advertise, in.Transport, in.Branch)
+	if err != nil {
+		return Message{}, err
+	}
+	r.PrependHeader(via)
+	if in.Contact != "" {
+		contact, err := parseNativeContact(in.Contact)
+		if err != nil {
+			return Message{}, err
+		}
+		r.AppendHeader(&sip.ContactHeader{DisplayName: contact.DisplayName, Address: contact.Address, Params: contact.Params})
+	}
+	r.SetBody(bytes.Clone(in.Body))
+	if len(in.Body) > 0 {
+		r.AppendHeader(sip.NewHeader("Content-Type", "application/sdp"))
+	}
+	if err := applyHeaders(r, remaining); err != nil {
+		return Message{}, err
+	}
+	return wire(r, in.Transport, "", ""), nil
+}
+
+func BuildResponseWithHeaders(origin Message, status int, reason string, body []byte, localTag, contact string, headers []Header) (Message, error) {
+	if strings.ContainsAny(reason, "\r\n\x00") {
+		return Message{}, errors.New("invalid reason phrase")
+	}
+	m, err := ResponseFor(origin, status, reason, body, localTag)
+	if err != nil {
+		return Message{}, err
+	}
+	r, err := response(m)
+	if err != nil {
+		return Message{}, err
+	}
+	o, err := request(origin)
+	if err != nil {
+		return Message{}, err
+	}
+	registration := o.Method == sip.REGISTER
+	if contact != "" && status != 100 && !registration {
+		value, err := parseNativeContact(contact)
+		if err != nil {
+			return Message{}, err
+		}
+		r.AppendHeader(&sip.ContactHeader{DisplayName: value.DisplayName, Address: value.Address, Params: value.Params})
+	}
+	if len(body) > 0 {
+		r.AppendHeader(sip.NewHeader("Content-Type", "application/sdp"))
+	}
+	contentHeaders := headers
+	if registration && status >= 200 && status < 300 {
+		contentHeaders = make([]Header, 0, len(headers))
+		for _, h := range headers {
+			if strings.EqualFold(h.Name, "Contact") || strings.EqualFold(h.Name, "m") {
+				if strings.TrimSpace(h.Value) == "*" {
+					return Message{}, errors.New("REGISTER response requires concrete binding Contacts")
+				}
+				value, err := parseAddress(h.Value)
+				if err != nil {
+					return Message{}, err
+				}
+				r.AppendHeader(&sip.ContactHeader{DisplayName: value.DisplayName, Address: value.Address, Params: value.Params})
+			} else {
+				contentHeaders = append(contentHeaders, h)
+			}
+		}
+	}
+	if err := applyHeaders(r, contentHeaders); err != nil {
+		return Message{}, err
+	}
+	return wire(r, m.Transport, m.Source, m.Destination), nil
+}
+
+func BuildDialogRequestWithHeaders(s Dialog, method sip.RequestMethod, sequence uint32, body []byte, branch string, headers []Header) (Message, error) {
+	m, err := BuildDialogRequest(s, method, sequence, body, branch)
+	if err != nil {
+		return Message{}, err
+	}
+	r, err := request(m)
+	if err != nil {
+		return Message{}, err
+	}
+	if err := applyHeaders(r, headers); err != nil {
+		return Message{}, err
+	}
+	return wire(r, m.Transport, m.Source, m.Destination), nil
+}
+
+func validToken(v string) bool {
+	if v == "" {
+		return false
+	}
+	for _, c := range v {
+		if c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || strings.ContainsRune("-.!%*_+`'~", c) {
+			continue
+		}
+		return false
+	}
+	return true
+}
+
+func buildVia(advertise, transport, branch string) (*sip.ViaHeader, error) {
+	host, portText, err := net.SplitHostPort(advertise)
+	if err != nil || host == "" || strings.ContainsAny(host, "\r\n\x00") {
+		return nil, errors.New("local Via host:port required")
+	}
+	port, err := strconv.Atoi(portText)
+	if err != nil || port < 1 || port > 65535 {
+		return nil, errors.New("invalid Via port")
+	}
+	params := sip.NewParams()
+	params.Add("branch", branch)
+	params.Add("rport", "")
+	return &sip.ViaHeader{ProtocolName: "SIP", ProtocolVersion: "2.0", Transport: strings.ToUpper(transport), Host: host, Port: port, Params: params}, nil
+}
+
+func parseAddress(value string) (*sip.ContactHeader, error) {
+	if strings.ContainsAny(value, "\r\n\x00") {
+		return nil, errors.New("invalid address value")
+	}
+	var uri sip.Uri
+	params := sip.NewParams()
+	name, err := sip.ParseAddressValue(value, &uri, &params)
+	if err != nil || uri.Host == "" {
+		return nil, errors.New("invalid address value")
+	}
+	return &sip.ContactHeader{DisplayName: name, Address: uri, Params: params}, nil
+}
+
+func parseNativeContact(value string) (*sip.ContactHeader, error) {
+	if strings.Contains(value, "<") {
+		return parseAddress(value)
+	}
+	if strings.ContainsAny(value, "\r\n\x00") {
+		return nil, errors.New("invalid native Contact")
+	}
+	var uri sip.Uri
+	if err := sip.ParseUri(value, &uri); err != nil || uri.Host == "" {
+		return nil, errors.New("invalid native Contact URI")
+	}
+	return &sip.ContactHeader{Address: uri, Params: sip.NewParams()}, nil
+}
+
+type headerMessage interface {
+	sip.Message
+	RemoveHeader(string) bool
+}
+
+func applyHeaders(m headerMessage, headers []Header) error {
+	for _, h := range headers {
+		if !validToken(h.Name) || strings.ContainsAny(h.Value, "\r\n\x00") {
+			return errors.New("invalid application header")
+		}
+		switch strings.ToLower(h.Name) {
+		case "via", "v", "from", "f", "to", "t", "call-id", "i", "cseq", "route", "record-route", "max-forwards", "contact", "m", "content-length", "l":
+			return errors.New("application header conflicts with native identity/routing/framing")
+		case "content-type", "c":
+			m.RemoveHeader("Content-Type")
+		}
+		m.AppendHeader(sip.NewHeader(h.Name, h.Value))
+	}
+	return nil
+}
diff --git a/sip/portable/build_test.go b/sip/portable/build_test.go
