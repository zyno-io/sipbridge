+	if tag(r.From().Params) != "local-tag" || r.From().DisplayName != "Caller" || r.To().Address.User != "bob" || r.GetHeader("Content-Type").Value() != "text/plain" || len(r.GetHeaders("X-Test")) != 2 {
+		t.Fatal("application headers/identity lost")
