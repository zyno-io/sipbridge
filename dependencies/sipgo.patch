+func TestPortableDigestRetryUsesFullURIAndCommittedIdentity(t *testing.T) {
+	o := origin(t, sip.INVITE, "tls")
+	challenge := reply(t, o, 407, "challenge-tag")
+	challenge = mutate(t, challenge, func(v sip.Message) {
+		v.AppendHeader(sip.NewHeader("Proxy-Authenticate", `Digest realm="example.test", nonce="fixed-nonce", algorithm=MD5, qop="auth"`))
+	})
+	creds := DigestCredentials{Username: "alice", Password: "test-only-secret", Cnonce: "fixed-cnonce", Count: 1}
+	m, e := BuildDigestRetry(o, challenge, creds, "z9hG4bK-authenticated")
+	if e != nil {
+		t.Fatal(e)
+	}
+	r, _ := testRequest(m)
+	original, _ := testRequest(o)
+	if r.CSeq().SeqNo != original.CSeq().SeqNo+1 || r.Via().Params.GetOr("branch", "") != "z9hG4bK-authenticated" || tag(r.To().Params) != "" {
+		t.Fatal("retry native identity wrong")
+	}
+	full := original.Recipient.String()
+	if !strings.Contains(full, "user=phone") || !strings.Contains(full, "Subject=test") {
+		t.Fatal("test lacks full URI")
+	}
+	parsed, e := digest.ParseCredentials(r.GetHeader("Proxy-Authorization").Value())
+	if e != nil {
+		t.Fatal(e)
+	}
+	if parsed.URI != full {
+		t.Fatal("URI parameters/query dropped")
+	}
+	c, e := digest.ParseChallenge(`Digest realm="example.test", nonce="fixed-nonce", algorithm=MD5, qop="auth"`)
+	if e != nil {
+		t.Fatal(e)
+	}
+	expected, e := digest.Digest(c, digest.Options{Method: "INVITE", URI: full, Username: creds.Username, Password: creds.Password, Cnonce: creds.Cnonce, Count: 1})
+	if e != nil {
+		t.Fatal(e)
+	}
+	if parsed.Response != expected.Response {
+		t.Fatal("digest response mismatch")
+	}
+	if bytes.Contains(m.WireBytes(), []byte(creds.Password)) {
+		t.Fatal("plaintext secret in retry")
+	}
+	if _, e = BuildDigestRetry(o, challenge, DigestCredentials{Username: "alice", Password: creds.Password}, "z9hG4bK-auth"); e == nil {
+		t.Fatal("missing entropy silently generated")
+	}
+}
+
+func TestPortableResponseMatchingChecksFullNativeOrigin(t *testing.T) {
+	o := origin(t, sip.INVITE, "tls")
+	res := reply(t, o, 200, "remote-tag")
+	if !MatchResponse(o, res) {
+		t.Fatal("valid response")
+	}
+	for name, change := range map[string]func(sip.Message){"call-id": func(v sip.Message) { *v.CallID() = "other" }, "from-tag": func(v sip.Message) { v.From().Params.Add("tag", "other") }, "cseq": func(v sip.Message) { v.CSeq().SeqNo++ }, "branch": func(v sip.Message) { v.Via().Params.Add("branch", "z9hG4bK-other") }, "sent-by": func(v sip.Message) { v.Via().Host = "other.example.test" }} {
+		t.Run(name, func(t *testing.T) {
+			if MatchResponse(o, mutate(t, res, change)) {
+				t.Fatal("borrowed transaction proof")
+			}
+		})
+	}
+	changed := RestoreMessage(res.WireBytes(), "tcp", res.Source(), res.Destination())
+	if MatchResponse(o, changed) {
+		t.Fatal("observed transport downgrade")
+	}
+	inDialog := mutate(t, o, func(v sip.Message) { v.To().Params.Add("tag", "fixed-remote") })
+	response := reply(t, inDialog, 200, "fixed-remote")
+	if !MatchResponse(inDialog, response) || MatchResponse(inDialog, mutate(t, response, func(v sip.Message) { v.To().Params.Add("tag", "other") })) {
+		t.Fatal("in-dialog remote tag not pinned")
+	}
+}
diff --git a/sip/portable/cancel_deadline_test.go b/sip/portable/cancel_deadline_test.go
new file mode 100644
index 0000000..1b6fe7c
--- /dev/null
+++ b/sip/portable/cancel_deadline_test.go
@@ -0,0 +1,52 @@
+package portable
+
+import (
+	"testing"
+
+	"github.com/emiago/sipgo/sip"
+)
+
+func TestPortableCancelledInviteHasFixedFinalResponseDeadline(t *testing.T) {
+	for _, transport := range []string{"udp", "tcp", "tls"} {
+		t.Run(transport, func(t *testing.T) {
+			request := origin(t, sip.INVITE, transport)
+			s, _ := step(t, tx(t, InviteClient, request), Input{Kind: Start, Now: 1000})
+			s, effects := step(t, s, Input{Kind: RequestCancel, Now: 1100})
+			if count(effects, StartTransaction) != 0 || s.Timers[TimerCancel].Active {
+				t.Fatal("CANCEL started before a provisional response")
+			}
+			s, effects = step(t, s, Input{Kind: ReceiveResponse, Now: 1200, Message: reply(t, request, 180, "remote-tag")})
+			deadline := s.Timers[TimerCancel]
+			if count(effects, StartTransaction) != 1 || !deadline.Active || deadline.At != 1200+64*s.Profile.T1 {
+				t.Fatal("original INVITE cancellation deadline missing")
+			}
+			s, _ = step(t, s, Input{Kind: RequestCancel, Now: 1300})
+			s, _ = step(t, s, Input{Kind: ReceiveResponse, Now: 1400, Message: reply(t, request, 183, "remote-tag")})
+			if s.Timers[TimerCancel] != deadline {
+				t.Fatal("duplicate cancellation or provisional response extended the deadline")
+			}
+			before, effects := step(t, s, Input{Kind: TimerFired, Timer: TimerCancel, Generation: deadline.Generation, Now: deadline.At - 1})
+			if before.Phase != Proceeding || count(effects, Ended) != 0 {
+				t.Fatal("cancellation ended before its original deadline")
+			}
+			ended, effects := step(t, s, Input{Kind: TimerFired, Timer: TimerCancel, Generation: deadline.Generation, Now: deadline.At})
+			if ended.Phase != Terminated || ended.Timers[TimerCancel].Active || count(effects, Ended) != 1 {
+				t.Fatal("original INVITE did not terminate after cancellation timeout")
+			}
+			_, effects = step(t, ended, Input{Kind: TimerFired, Timer: TimerCancel, Generation: deadline.Generation, Now: deadline.At + 1})
+			if count(effects, Ended) != 0 {
+				t.Fatal("cancellation timeout terminated twice")
+			}
+			for _, status := range []int{200, 487} {
+				final, _ := step(t, s, Input{Kind: ReceiveResponse, Now: 1500, Message: reply(t, request, status, "remote-tag")})
+				if final.Timers[TimerCancel].Active {
+					t.Fatal("INVITE final retained the cancellation watchdog")
+				}
+				late, effects := step(t, final, Input{Kind: TimerFired, Timer: TimerCancel, Generation: deadline.Generation, Now: deadline.At})
+				if late.Phase != final.Phase || count(effects, Ended) != 0 {
+					t.Fatal("stale cancellation timer terminated a completed INVITE")
+				}
+			}
+		})
+	}
+}
diff --git a/sip/portable/dialog.go b/sip/portable/dialog.go
new file mode 100644
index 0000000..ceb96c0
--- /dev/null
+++ b/sip/portable/dialog.go
@@ -0,0 +1,729 @@
+package portable
+
+import (
+	"errors"
+	"math"
+	"net"
+	"strconv"
+	"strings"
+
+	"github.com/emiago/sipgo/sip"
+)
+
+type Role string
+
+const (
+	UAC Role = "uac"
+	UAS Role = "uas"
+)
+
+type DialogPhase string
+
+const (
+	DialogEarly       DialogPhase = "early"
+	DialogAwaitingACK DialogPhase = "awaiting_ack"
+	DialogConfirmed   DialogPhase = "confirmed"
+	DialogTerminating DialogPhase = "terminating"
+	DialogEnded       DialogPhase = "ended"
+)
+
+type OfferState string
+
+const (
+	NoOffer          OfferState = "none"
+	LocalOffer       OfferState = "local"
+	RemoteOffer      OfferState = "remote"
+	LocalOfferInACK  OfferState = "local_ack"
+	RemoteOfferInACK OfferState = "remote_ack"
+)
+
+type InviteState string
+
+const (
+	InvitePending     InviteState = "pending"
+	InviteAwaitingACK InviteState = "awaiting_ack"
+	InviteAcked       InviteState = "acked"
+	InviteRejected    InviteState = "rejected"
+)
+
+type InviteProcedure struct {
+	State           InviteState `json:"state"`
+	Sequence        uint32      `json:"sequence"`
+	Initial         bool        `json:"initial"`
+	Request         Message     `json:"request"`
+	Final           *Message    `json:"final,omitempty"`
+	ACK             *Message    `json:"ack,omitempty"`
+	CancelRequested bool        `json:"cancel_requested,omitempty"`
+}
+type Dialog struct {
+	Version      int                `json:"version"`
+	Role         Role               `json:"role"`
+	Phase        DialogPhase        `json:"phase"`
+	CallID       string             `json:"call_id"`
+	LocalTag     string             `json:"local_tag"`
+	RemoteTag    string             `json:"remote_tag"`
+	LocalURI     string             `json:"local_uri"`
+	RemoteURI    string             `json:"remote_uri"`
+	Contact      string             `json:"contact"`
+	SentBy       string             `json:"sent_by"`
+	Target       string             `json:"target"`
+	Routes       []string           `json:"routes"`
+	Transport    string             `json:"transport"`
+	LocalCSeq    uint32             `json:"local_cseq"`
+	LocalSet     bool               `json:"local_set"`
+	RemoteCSeq   uint32             `json:"remote_cseq"`
+	RemoteSet    bool               `json:"remote_set"`
+	LocalInvite  *InviteProcedure   `json:"local_invite,omitempty"`
+	RemoteInvite *InviteProcedure   `json:"remote_invite,omitempty"`
+	LocalBye     *Message           `json:"local_bye,omitempty"`
+	Retiring     bool               `json:"retiring"`
+	Offer        OfferState         `json:"offer"`
+	Timers       map[Timer]Deadline `json:"timers"`
+	Profile      TimerProfile       `json:"profile"`
+}
+type DialogInputKind string
+
+const (
+	DialogStart           DialogInputKind = "start"
+	DialogReceiveRequest  DialogInputKind = "receive_request"
+	DialogReceiveResponse DialogInputKind = "receive_response"
+	DialogSendResponse    DialogInputKind = "send_response"
+	DialogLocalRequest    DialogInputKind = "local_request"
+	DialogLocalACK        DialogInputKind = "local_ack"
+	DialogTimer           DialogInputKind = "timer"
+	DialogTerminate       DialogInputKind = "terminate"
+	DialogCancel          DialogInputKind = "cancel"
+)
+
+type DialogInput struct {
+	Kind       DialogInputKind
+	Now        int64
+	Message    Message
+	Method     sip.RequestMethod
+	Body       []byte
+	Branch     string
+	Timer      Timer
+	Generation uint64
+	Offer      bool
+	Answer     bool
+	Headers    []Header
+}
+
+// NewDialog constructs one directional branch. For UAS, submit the chosen
+// response through DialogSendResponse to arm TU timers and its response effect.
+// For UAC, DialogStart reports the pending ACK after a successful response.
+func NewDialog(role Role, origin, reply Message, profile TimerProfile) (Dialog, error) {
+	if role != UAC && role != UAS || !profile.valid() || !MatchResponse(origin, reply) {
+		return Dialog{}, errors.New("invalid dialog origin")
+	}
+	o, _ := request(origin)
+	r, _ := response(reply)
+	if !(o.facts.Method == sip.INVITE) || r.facts.Status <= 100 || r.facts.Status >= 300 || o.facts.FromTag == "" || r.facts.ToTag == "" {
+		return Dialog{}, errors.New("tagged INVITE provisional/success required")
+	}
+	s := Dialog{Version: Version, Role: role, Phase: DialogEarly, CallID: o.facts.CallID, Transport: origin.Transport(), Profile: profile, Timers: make(map[Timer]Deadline), Offer: NoOffer}
+	p := &InviteProcedure{State: InvitePending, Sequence: o.facts.CSeq, Initial: true, Request: origin.Clone()}
+	var routeHeaders []string
+	if role == UAC {
+		s.LocalTag, s.RemoteTag = o.facts.FromTag, r.facts.ToTag
+		s.LocalURI, s.RemoteURI = o.facts.FromURI, r.facts.ToURI
+		s.LocalCSeq, s.LocalSet = o.facts.CSeq, true
+		s.LocalInvite = p
+		if r.contact == nil {
+			return Dialog{}, errors.New("remote Contact required")
+		}
+		s.Target = r.facts.ContactURI
+		routeHeaders = r.headerValues("Record-Route")
+		for i := len(routeHeaders) - 1; i >= 0; i-- {
+			s.Routes = append(s.Routes, routeHeaders[i])
+		}
+		if o.contact != nil {
+			s.Contact = o.facts.ContactURI
+		}
+		s.SentBy = o.facts.ViaSentBy
+		if r.facts.Status >= 200 && r.facts.Status < 300 {
+			p.State = InviteAwaitingACK
+			p.Final = cloneMessage(&reply)
+			if !s.Retiring {
+				s.Phase = DialogAwaitingACK
+			}
+		}
+		if isSDP(o) && !isSDP(r) {
+			s.Offer = LocalOffer
+		}
+		if !isSDP(o) && isSDP(r) {
+			s.Offer = RemoteOfferInACK
+		}
+	} else {
+		s.LocalTag, s.RemoteTag = r.facts.ToTag, o.facts.FromTag
+		s.LocalURI, s.RemoteURI = r.facts.ToURI, o.facts.FromURI
+		s.RemoteCSeq, s.RemoteSet = o.facts.CSeq, true
+		s.RemoteInvite = p
+		if o.contact == nil {
+			return Dialog{}, errors.New("remote Contact required")
+		}
+		s.Target = o.facts.ContactURI
+		routeHeaders = o.headerValues("Record-Route")
+		for _, h := range routeHeaders {
+			s.Routes = append(s.Routes, h)
+		}
+		if r.contact != nil {
+			s.Contact = r.facts.ContactURI
+			s.SentBy = r.facts.ContactHostPort
+		}
+		if isSDP(o) {
+			s.Offer = RemoteOffer
+		}
+	}
+	if err := s.Validate(); err != nil {
+		return Dialog{}, err
+	}
+	return s, nil
+}
+
+func isSDP(m *frozenMessage) bool { return m.facts.SDP }
+func cloneProcedure(p *InviteProcedure) *InviteProcedure {
+	if p == nil {
+		return nil
+	}
+	v := *p
+	v.Request = p.Request.Clone()
+	v.Final = cloneMessage(p.Final)
+	v.ACK = cloneMessage(p.ACK)
+	return &v
+}
+func (s Dialog) Clone() Dialog {
+	s.Routes = append([]string(nil), s.Routes...)
+	s.LocalInvite = cloneProcedure(s.LocalInvite)
+	s.RemoteInvite = cloneProcedure(s.RemoteInvite)
+	s.LocalBye = cloneMessage(s.LocalBye)
+	m := make(map[Timer]Deadline, len(s.Timers))
+	for k, v := range s.Timers {
+		m[k] = v
+	}
+	s.Timers = m
+	return s
+}
+func MatchDialogRequest(s Dialog, m Message) bool {
+	r, e := request(m)
+	return e == nil && m.Transport() == s.Transport && r.facts.CallID == s.CallID && r.facts.ToTag == s.LocalTag && r.facts.FromTag == s.RemoteTag && s.LocalTag != "" && s.RemoteTag != ""
+}
+func MatchDialogResponse(s Dialog, m Message) bool {
+	r, e := response(m)
+	return e == nil && m.Transport() == s.Transport && r.facts.CallID == s.CallID && r.facts.FromTag == s.LocalTag && r.facts.ToTag == s.RemoteTag && s.LocalTag != "" && s.RemoteTag != ""
+}
+
+// BuildDialogRequest freezes role-correct loose/strict routes and supplied Via
+// branch without entropy or CSeq allocation. StepDialog owns sequence allocation.
+func buildDialogRequest(s Dialog, method sip.RequestMethod, sequence uint32, body []byte, branch string) (*sip.Request, string, error) {
+	if !validToken(string(method)) || !validToken(s.LocalTag) || !validToken(s.RemoteTag) || sequence > math.MaxInt32 ||
+		(s.Transport != "udp" && s.Transport != "tcp" && s.Transport != "tls") || !validBranch(branch) ||
+		strings.ContainsAny(s.Contact+s.SentBy+s.Target+s.LocalURI+s.RemoteURI+s.CallID, "\r\n\x00") {
+		return nil, "", errors.New("invalid dialog build identity")
+	}
+	var target, local, remote sip.Uri
+	for _, v := range []struct {
+		text string
+		uri  *sip.Uri
+	}{{s.Target, &target}, {s.LocalURI, &local}, {s.RemoteURI, &remote}} {
+		if e := sip.ParseUri(v.text, v.uri); e != nil {
+			return nil, "", e
+		}
+	}
+	if target.IsEncrypted() && s.Transport != "tls" {
+		return nil, "", errors.New("SIPS requires TLS")
+	}
+	routes := append([]string(nil), s.Routes...)
+	destination := ""
+	if len(routes) > 0 {
+		var first sip.Uri
+		params := sip.NewParams()
+		if _, e := sip.ParseAddressValue(routes[0], &first, &params); e != nil {
+			return nil, "", e
+		}
+		destination = first.HostPort()
+		if !first.UriParams.Has("lr") {
+			routes = append(routes[1:], "<"+target.String()+">")
+			target = first
+		}
+	}
+	r := sip.NewRequest(method, target)
+	from, to := sip.NewParams(), sip.NewParams()
+	from.Add("tag", s.LocalTag)
+	to.Add("tag", s.RemoteTag)
+	r.AppendHeader(&sip.FromHeader{Address: local, Params: from})
+	r.AppendHeader(&sip.ToHeader{Address: remote, Params: to})
+	id := sip.CallIDHeader(s.CallID)
+	r.AppendHeader(&id)
+	r.AppendHeader(&sip.CSeqHeader{SeqNo: sequence, MethodName: method})
+	fwd := sip.MaxForwardsHeader(70)
+	r.AppendHeader(&fwd)
+	host, portText, e := net.SplitHostPort(s.SentBy)
+	if e != nil {
+		return nil, "", errors.New("local Via sent-by host:port required")
+	}
+	port, e := strconv.Atoi(portText)
+	if e != nil || port < 1 || port > 65535 {
+		return nil, "", errors.New("invalid Via port")
+	}
+	vp := sip.NewParams()
+	vp.Add("branch", branch)
+	vp.Add("rport", "")
+	r.PrependHeader(&sip.ViaHeader{ProtocolName: "SIP", ProtocolVersion: "2.0", Transport: strings.ToUpper(s.Transport), Host: host, Port: port, Params: vp})
+	for _, route := range routes {
+		if strings.ContainsAny(route, "\r\n") {
+			return nil, "", errors.New("invalid route")
+		}
+		r.AppendHeader(sip.NewHeader("Route", route))
+	}
+	if s.Contact != "" && method != sip.ACK {
+		var contact sip.Uri
+		if e := sip.ParseUri(s.Contact, &contact); e != nil {
+			return nil, "", e
+		}
+		r.AppendHeader(&sip.ContactHeader{Address: contact})
+	}
+	r.SetBody(body)
+	if len(body) > 0 {
+		r.AppendHeader(sip.NewHeader("Content-Type", "application/sdp"))
+	}
+	return r, destination, nil
+}
+
+func BuildDialogRequest(s Dialog, method sip.RequestMethod, sequence uint32, body []byte, branch string) (Message, error) {
+	r, destination, err := buildDialogRequest(s, method, sequence, body, branch)
+	if err != nil {
+		return Message{}, err
+	}
+	return wire(r, s.Transport, "", destination), nil
+}
+
+type dialogTransition struct {
+	state   Dialog
+	effects []Effect
+	now     int64
+	err     error
+}
+
+func (d *dialogTransition) emit(k EffectKind, m *Message, replay bool) {
+	d.effects = append(d.effects, Effect{Kind: k, Message: cloneMessage(m), Replay: replay})
+}
+func (d *dialogTransition) schedule(k Timer, after, interval int64) {
+	v := d.state.Timers[k]
+	if v.Generation == math.MaxUint64 || after < 0 || d.now > math.MaxInt64-after {
+		d.err = errors.New("deadline exhausted")
+		return
+	}
+	v = Deadline{Generation: v.Generation + 1, At: d.now + after, Interval: interval, Active: true}
+	d.state.Timers[k] = v
+	d.effects = append(d.effects, Effect{Kind: Schedule, Timer: k, Deadline: v})
+}
+func (d *dialogTransition) stop(k Timer) {
+	v := d.state.Timers[k]
+	if v.Active {
+		v.Active = false
+		d.state.Timers[k] = v
+		d.effects = append(d.effects, Effect{Kind: CancelTimer, Timer: k, Deadline: v})
+	}
+}
+func (d *dialogTransition) end() {
+	d.state.Retiring = true
+	if d.state.Phase == DialogEnded {
+		return
+	}
+	d.state.Phase = DialogEnded
+	d.stop(Timer2xx)
+	d.stop(TimerACK)
+	d.emit(Ended, nil, false)
+}
+func pending(p *InviteProcedure) bool {
+	return p != nil && (p.State == InvitePending || p.State == InviteAwaitingACK)
+}
+
+func StepDialog(s Dialog, in DialogInput) (Dialog, []Effect, error) {
+	if s.Validate() != nil || in.Now < 0 {
+		return s, nil, errors.New("invalid dialog state/environment")
+	}
+	d := dialogTransition{state: s.Clone(), now: in.Now}
+	if d.state.Timers == nil {
+		d.state.Timers = make(map[Timer]Deadline)
+	}
+	if in.Kind == DialogTerminate {
+		d.end()
+		return d.state, d.effects, nil
+	}
+	if s.Phase == DialogEnded && in.Kind != DialogReceiveResponse && in.Kind != DialogLocalACK {
+		return s, nil, reject(481, "dialog ended")
+	}
+	switch in.Kind {
+	case DialogStart:
+		if s.LocalInvite != nil && s.LocalInvite.State == InviteAwaitingACK {
+			d.emit(NeedACK, s.LocalInvite.Final, false)
+		}
+	case DialogReceiveRequest:
+		if !MatchDialogRequest(s, in.Message) {
+			return s, nil, reject(481, "directional dialog identity mismatch")
+		}
+		r, _ := request(in.Message)
+		if r.facts.Method == sip.ACK {
+			p := d.state.RemoteInvite
+			if p == nil || p.Sequence != r.facts.CSeq || p.State != InviteAwaitingACK && p.State != InviteAcked {
+				return s, nil, reject(500, "ACK INVITE sequence mismatch")
+			}
+			if p.State == InviteAcked {
+				return d.state, nil, nil
+			}
+			if s.Offer == LocalOfferInACK && !isSDP(r) {
+				return s, nil, reject(488, "ACK answer required")
+			}
+			p.State = InviteAcked
+			p.ACK = cloneMessage(&in.Message)
+			d.state.Offer = NoOffer
+			if !d.state.Retiring {
+				d.state.Phase = DialogConfirmed
+			}
+			d.stop(Timer2xx)
+			d.stop(TimerACK)
+			d.emit(Acknowledged, &in.Message, false)
+			break
+		}
+		if r.facts.Method == sip.CANCEL {
+			return s, nil, reject(481, "CANCEL requires exact transaction association")
+		}
+		if (s.Retiring || s.Phase == DialogTerminating) && r.facts.Method != sip.BYE {
+			return s, nil, reject(481, "dialog terminating")
+		}
+		if s.RemoteSet && r.facts.CSeq <= s.RemoteCSeq {
+			return s, nil, reject(500, "remote CSeq must increase")
+		}
+		if (r.facts.Method == sip.INVITE) && (pending(s.LocalInvite) || pending(s.RemoteInvite) || s.Offer != NoOffer) {
+			return s, nil, reject(491, "INVITE procedure pending")
+		}
+		d.state.RemoteCSeq, d.state.RemoteSet = r.facts.CSeq, true
+		if r.facts.Method == sip.INVITE {
+			d.state.RemoteInvite = &InviteProcedure{State: InvitePending, Sequence: r.facts.CSeq, Request: in.Message.Clone()}
+			if in.Offer || isSDP(r) {
+				d.state.Offer = RemoteOffer
+			}
+		}
+		if r.facts.Method == sip.BYE {
+			m, e := ResponseFor(in.Message, 200, "OK", nil, s.LocalTag)
+			if e != nil {
+				return s, nil, e
+			}
+			d.emit(Respond, &m, false)
+			d.end()
+		} else {
+			d.emit(PresentRequest, &in.Message, false)
+		}
+	case DialogLocalRequest:
+		if (s.Retiring || s.Phase == DialogTerminating) && (in.Method != sip.BYE || s.LocalBye != nil || s.LocalInvite != nil && s.LocalInvite.State != InviteAcked) {
+			return s, nil, reject(481, "dialog terminating")
+		}
+		if in.Method == sip.ACK || in.Method == sip.CANCEL {
+			return s, nil, errors.New("use ACK procedure or transaction CANCEL")
+		}
+		if in.Method == sip.INVITE && (pending(s.LocalInvite) || pending(s.RemoteInvite) || s.Offer != NoOffer) {
+			return s, nil, reject(491, "INVITE procedure pending")
+		}
+		if s.LocalCSeq >= math.MaxInt32 {
+			return s, nil, errors.New("CSeq exhausted")
+		}
+		seq := s.LocalCSeq + 1
+		m, e := BuildDialogRequestWithHeaders(s, in.Method, seq, in.Body, in.Branch, in.Headers)
+		if e != nil {
+			return s, nil, e
+		}
+		d.state.LocalCSeq, d.state.LocalSet = seq, true
+		if in.Method == sip.INVITE {
+			d.state.LocalInvite = &InviteProcedure{State: InvitePending, Sequence: seq, Request: m.Clone()}
+			if in.Offer || len(in.Body) > 0 {
+				d.state.Offer = LocalOffer
+			}
+		}
+		if in.Method == sip.BYE {
+			d.state.Retiring = true
+			d.state.Phase = DialogTerminating
+			d.state.LocalBye = cloneMessage(&m)
+		}
+		d.emit(StartTransaction, &m, false)
+	case DialogLocalACK:
+		p := d.state.LocalInvite
+		if p == nil || p.State != InviteAwaitingACK && p.State != InviteAcked {
+			return s, nil, errors.New("no successful INVITE ACK obligation")
+		}
+		if p.ACK != nil {
+			d.emit(Send, p.ACK, true)
+			break
+		}
+		if s.Offer == RemoteOfferInACK && len(in.Body) == 0 {
+			return s, nil, reject(488, "ACK answer required")
+		}
+		m, e := BuildDialogRequestWithHeaders(s, sip.ACK, p.Sequence, in.Body, in.Branch, in.Headers)
+		if e != nil {
+			return s, nil, e
+		}
+		p.ACK = &m
+		p.State = InviteAcked
+		d.state.Offer = NoOffer
+		if !d.state.Retiring {
+			d.state.Phase = DialogConfirmed
+		}
+		d.emit(Send, &m, false)
+		if p.CancelRequested && d.state.LocalBye == nil && d.state.Phase != DialogEnded {
+			d.state.Retiring = true
+			d.state.Phase = DialogTerminating
+			d.state.Retiring = true
+			d.emit(NeedBYE, p.Final, false)
+		}
+	case DialogCancel:
+		p := d.state.LocalInvite
+		if p == nil {
+			return s, nil, errors.New("no local INVITE to cancel")
+		}
+		p.CancelRequested = true
+		d.state.Retiring = true
+		d.state.Phase = DialogTerminating
+		if p.State == InviteAwaitingACK {
+			d.emit(NeedACK, p.Final, false)
+		} else if p.State == InviteAcked && s.LocalBye == nil {
+			d.state.Phase = DialogTerminating
+			d.state.Retiring = true
+			d.emit(NeedBYE, p.Final, false)
+		}
+	case DialogSendResponse:
+		d.reply(in.Message, in.Answer, in.Offer)
+	case DialogReceiveResponse:
+		d.receive(in.Message)
+	case DialogTimer:
+		v := s.Timers[in.Timer]
+		if !v.Active || v.Generation != in.Generation || in.Now < v.At {
+			return d.state, nil, nil
+		}
+		v.Active = false
+		d.state.Timers[in.Timer] = v
+		if in.Timer == TimerACK {
+			d.stop(Timer2xx)
+			d.state.Phase = DialogTerminating
+			d.state.Retiring = true
+			d.emit(NeedBYE, nil, false)
+		} else if in.Timer == Timer2xx && s.RemoteInvite != nil && s.RemoteInvite.State == InviteAwaitingACK {
+			if a := s.Timers[TimerACK]; a.Active && in.Now >= a.At {
+				d.stop(Timer2xx)
+				d.stop(TimerACK)
+				d.state.Phase = DialogTerminating
+				d.state.Retiring = true
+				d.emit(NeedBYE, nil, false)
+			} else {
+				d.emit(Respond, s.RemoteInvite.Final, true)
+				interval := min(min(v.Interval, math.MaxInt64/2)*2, s.Profile.T2)
+				d.schedule(Timer2xx, interval, interval)
+			}
+		}
+	default:
+		return s, nil, errors.New("unknown dialog input")
+	}
+	if d.err != nil {
+		return s, nil, d.err
+	}
+	return d.state, d.effects, nil
+}
+
+func (s Dialog) Validate() error {
+	if s.Version != Version || !s.Profile.valid() || s.Role != UAC && s.Role != UAS || !validToken(s.LocalTag) || !validToken(s.RemoteTag) || s.CallID == "" || s.LocalCSeq > math.MaxInt32 || s.RemoteCSeq > math.MaxInt32 || s.Transport != "udp" && s.Transport != "tcp" && s.Transport != "tls" {
+		return errors.New("invalid dialog state")
+	}
+	switch s.Phase {
+	case DialogEarly, DialogAwaitingACK, DialogConfirmed, DialogTerminating, DialogEnded:
+	default:
+		return errors.New("unknown dialog phase")
+	}
+	if (s.Phase == DialogTerminating || s.Phase == DialogEnded) != s.Retiring {
+		return errors.New("inconsistent retirement state")
+	}
+	if s.LocalBye != nil && !s.Retiring {
+		return errors.New("BYE without retirement")
+	}
+	switch s.Offer {
+	case NoOffer, LocalOffer, RemoteOffer, LocalOfferInACK, RemoteOfferInACK:
+	default:
+		return errors.New("unknown offer phase")
+	}
+	for _, p := range []*InviteProcedure{s.LocalInvite, s.RemoteInvite} {
+		if p == nil {
+			continue
+		}
+		switch p.State {
+		case InvitePending, InviteAwaitingACK, InviteAcked, InviteRejected:
+		default:
+			return errors.New("unknown INVITE procedure")
+		}
+		if p.Sequence > math.MaxInt32 {
+			return errors.New("invalid INVITE sequence")
+		}
+		r, e := request(p.Request)
+		if e != nil || !(r.facts.Method == sip.INVITE) || r.facts.CSeq != p.Sequence || r.facts.CallID != s.CallID {
+			return errors.New("retained INVITE identity mismatch")
+		}
+	}
+	for k, v := range s.Timers {
+		if k != Timer2xx && k != TimerACK || v.At < 0 || v.Interval < 0 || v.Active && v.Generation == 0 {
+			return errors.New("invalid dialog timer")
+		}
+	}
+	return nil
+}
+
+func (d *dialogTransition) reply(m Message, answer, offer bool) {
+	s := &d.state
+	p := s.RemoteInvite
+	if p == nil || !MatchResponse(p.Request, m) {
+		d.err = reject(481, "response does not match remote INVITE")
+		return
+	}
+	r, _ := response(m)
+	if r.facts.ToTag != s.LocalTag {
+		d.err = reject(481, "response local tag mismatch")
+		return
+	}
+	if p.State == InviteRejected || p.State == InviteAcked {
+		if p.Final == nil || !p.Final.EqualWire(m) {
+			d.err = errors.New("conflicting INVITE final")
+		}
+		return
+	}
+	if p.State == InviteAwaitingACK {
+		if (r.facts.Status >= 200 && r.facts.Status < 300) && p.Final != nil && p.Final.EqualWire(m) {
+			d.emit(Respond, p.Final, true)
+		} else {
+			d.err = errors.New("conflicting INVITE final")
+		}
+		return
+	}
+	if r.facts.Status < 200 {
+		if s.Offer == RemoteOffer && isSDP(r) {
+			s.Offer = NoOffer
+		}
+		d.emit(Respond, &m, false)
+		return
+	}
+	p.Final = cloneMessage(&m)
+	if r.facts.Status >= 200 && r.facts.Status < 300 {
+		p.State = InviteAwaitingACK
+		if r.contact != nil {
+			s.Contact = r.facts.ContactURI
+			if s.SentBy == "" {
+				s.SentBy = r.facts.ContactHostPort
+			}
+		}
+		if !s.Retiring {
+			s.Phase = DialogAwaitingACK
+		}
+		o, _ := request(p.Request)
+		if o.contact != nil {
+			s.Target = o.facts.ContactURI
+		}
+		if s.Offer == RemoteOffer && !isSDP(r) {
+			d.err = reject(488, "INVITE answer required")
+			return
+		}
+		if !isSDP(o) && isSDP(r) {
+			s.Offer = LocalOfferInACK
+		} else {
+			s.Offer = NoOffer
+		}
+		d.schedule(Timer2xx, s.Profile.T1, s.Profile.T1)
+		d.schedule(TimerACK, 64*s.Profile.T1, 0)
+	} else {
+		p.State = InviteRejected
+		s.Offer = NoOffer
+		if p.Initial {
+			d.end()
+		}
+	}
+	d.emit(Respond, &m, false)
+}
+
+func (d *dialogTransition) receive(m Message) {
+	s := &d.state
+	if s.LocalBye != nil && MatchResponse(*s.LocalBye, m) && MatchDialogResponse(*s, m) {
+		r, _ := response(m)
+		d.emit(ReportResponse, &m, false)
+		if !(r.facts.Status < 200) {
+			d.end()
+		}
+		return
+	}
+	p := s.LocalInvite
+	if p == nil || !MatchResponse(p.Request, m) || !MatchDialogResponse(*s, m) {
+		d.err = reject(481, "response does not match local INVITE branch")
+		return
+	}
+	r, _ := response(m)
+	if r.facts.Status < 200 {
+		if p.State == InvitePending && s.Offer == LocalOffer && isSDP(r) {
+			s.Offer = NoOffer
+		}
+		if p.State == InvitePending {
+			d.emit(ReportResponse, &m, false)
+		}
+		return
+	}
+	if p.State == InviteRejected {
+		if p.Final == nil || !p.Final.EqualWire(m) {
+			d.err = reject(481, "conflicting INVITE final")
+			return
+		}
+		d.emit(ReportResponse, p.Final, true)
+		return
+	}
+	if p.State == InviteAcked || p.State == InviteAwaitingACK {
+		if !(r.facts.Status >= 200 && r.facts.Status < 300) || p.Final == nil || !p.Final.EqualWire(m) {
+			d.err = reject(481, "conflicting INVITE final")
+			return
+		}
+		if p.ACK != nil {
+			d.emit(Send, p.ACK, true)
+		} else {
+			d.emit(NeedACK, &m, true)
+		}
+		return
+	}
+	p.Final = cloneMessage(&m)
+	if r.facts.Status >= 200 && r.facts.Status < 300 {
+		if r.contact == nil {
+			d.err = errors.New("successful INVITE Contact required")
+			return
+		}
+		s.Target = r.facts.ContactURI
+		if p.Initial {
+			s.Routes = nil
+			headers := r.headerValues("Record-Route")
+			for i := len(headers) - 1; i >= 0; i-- {
+				s.Routes = append(s.Routes, headers[i])
+			}
+		}
+		p.State = InviteAwaitingACK
+		if !s.Retiring {
+			s.Phase = DialogAwaitingACK
+		}
+		o, _ := request(p.Request)
+		if s.Offer == LocalOffer && !isSDP(r) {
+			d.err = reject(488, "INVITE answer required")
+			return
+		}
+		if !isSDP(o) && isSDP(r) {
+			s.Offer = RemoteOfferInACK
+		} else {
+			s.Offer = NoOffer
+		}
+		d.emit(NeedACK, &m, false)
+	} else {
+		p.State = InviteRejected
+		s.Offer = NoOffer
+		if p.Initial {
+			d.end()
+		}
+	}
+	d.emit(ReportResponse, &m, false)
+}
diff --git a/sip/portable/dialog_test.go b/sip/portable/dialog_test.go
new file mode 100644
index 0000000..6c83df5
--- /dev/null
+++ b/sip/portable/dialog_test.go
@@ -0,0 +1,281 @@
+package portable
+
+import (
+	"bytes"
+	"encoding/json"
+	"testing"
+
+	"github.com/emiago/sipgo/sip"
+)
+
+func dialogStep(t *testing.T, s Dialog, in DialogInput) (Dialog, []Effect) {
+	t.Helper()
+	before, _ := json.Marshal(s)
+	next, e, err := StepDialog(hydrated(t, s), in)
+	if err != nil {
+		t.Fatal(err)
+	}
+	after, _ := json.Marshal(s)
+	if !bytes.Equal(before, after) {
+		t.Fatal("dialog input mutated")
+	}
+	return hydrated(t, next), e
+}
+func clientDialog(t *testing.T) Dialog {
+	t.Helper()
+	o := origin(t, sip.INVITE, "tls")
+	d, e := NewDialog(UAC, o, reply(t, o, 200, "remote-tag"), DefaultTimers())
+	if e != nil {
+		t.Fatal(e)
+	}
+	return d
+}
+func serverDialog(t *testing.T) Dialog {
+	t.Helper()
+	o := origin(t, sip.INVITE, "tls")
+	d, e := NewDialog(UAS, o, reply(t, o, 180, "remote-tag"), DefaultTimers())
+	if e != nil {
+		t.Fatal(e)
+	}
+	return d
+}
+func peerRequest(t *testing.T, d Dialog, method sip.RequestMethod, seq uint32, branch string) Message {
+	t.Helper()
+	reverse := Dialog{CallID: d.CallID, LocalTag: d.RemoteTag, RemoteTag: d.LocalTag, LocalURI: d.RemoteURI, RemoteURI: d.LocalURI, Target: d.Contact, Contact: d.Target, SentBy: "192.0.2.2:5061", Transport: d.Transport}
+	m, e := BuildDialogRequest(reverse, method, seq, nil, branch)
+	if e != nil {
+		t.Fatal(e)
+	}
+	return m
+}
+
+func TestPortableDialogIndependentSequencesAndACK(t *testing.T) {
+	d := clientDialog(t)
+	initial := d.LocalCSeq
+	d, e := dialogStep(t, d, DialogInput{Kind: DialogLocalACK, Now: 1, Branch: "z9hG4bK-ack"})
+	if d.LocalCSeq != initial || count(e, Send) != 1 || d.Phase != DialogConfirmed {
+		t.Fatal("ACK consumed local sequence")
+	}
+	info := peerRequest(t, d, sip.INFO, 2, "z9hG4bK-info")
+	d, _ = dialogStep(t, d, DialogInput{Kind: DialogReceiveRequest, Now: 2, Message: info})
+	if d.RemoteCSeq != 2 || d.LocalCSeq != 121787510 {
+		t.Fatal("remote small sequence rejected or local changed")
+	}
+	_, _, err := StepDialog(d, DialogInput{Kind: DialogReceiveRequest, Now: 3, Message: peerRequest(t, d, sip.INFO, 2, "z9hG4bK-new-branch")})
+	if err == nil {
+		t.Fatal("new equal-CSeq transaction admitted")
+	}
+	_, _, err = StepDialog(d, DialogInput{Kind: DialogReceiveRequest, Now: 3, Message: mutate(t, peerRequest(t, d, sip.INFO, 3, "z9hG4bK-wrong"), func(v sip.Message) { v.To().Params.Add("tag", "borrowed") })})
+	if err == nil {
+		t.Fatal("directional identity bypass")
+	}
+}
+
+func TestPortableServerACKAfterLaterRemoteRequest(t *testing.T) {
+	d := serverDialog(t)
+	o := d.RemoteInvite.Request
+	final := reply(t, o, 200, d.LocalTag)
+	d, _ = dialogStep(t, d, DialogInput{Kind: DialogSendResponse, Now: 1000, Message: final})
+	seq := d.RemoteInvite.Sequence
+	d, _ = dialogStep(t, d, DialogInput{Kind: DialogReceiveRequest, Now: 1100, Message: peerRequest(t, d, sip.INFO, seq+1, "z9hG4bK-info-after-final")})
+	ack := peerRequest(t, d, sip.ACK, seq, "z9hG4bK-dialog-ack")
+	d, e := dialogStep(t, d, DialogInput{Kind: DialogReceiveRequest, Now: 1200, Message: ack})
+	if d.Phase != DialogConfirmed || d.Timers[TimerACK].Active || count(e, Acknowledged) != 1 {
+		t.Fatal("valid ACK failed after greater INFO CSeq")
+	}
+	d, e = dialogStep(t, d, DialogInput{Kind: DialogReceiveRequest, Now: 1201, Message: ack})
+	if count(e, Acknowledged) != 0 || d.RemoteCSeq != seq+1 {
+		t.Fatal("duplicate ACK advanced state")
+	}
+}
+
+func TestPortableSuccessfulFinalHasFixedDeadlineAndCappedBackoff(t *testing.T) {
+	d := serverDialog(t)
+	d, _ = dialogStep(t, d, DialogInput{Kind: DialogSendResponse, Now: 1000, Message: reply(t, d.RemoteInvite.Request, 200, d.LocalTag)})
+	deadline := d.Timers[TimerACK].At
+	if deadline != 33000 {
+		t.Fatal("ACK deadline")
+	}
+	for _, at := range []int64{1500, 2500, 4500, 8500} {
+		var e []Effect
+		d, e = dialogStep(t, d, DialogInput{Kind: DialogTimer, Now: at, Timer: Timer2xx, Generation: d.Timers[Timer2xx].Generation})
+		if count(e, Respond) != 1 || d.Timers[TimerACK].At != deadline || d.Timers[Timer2xx].Interval > 4000 {
+			t.Fatal("TU retransmit changed overall lifetime")
+		}
+	}
+	d, e := dialogStep(t, d, DialogInput{Kind: DialogTimer, Now: 33000, Timer: TimerACK, Generation: d.Timers[TimerACK].Generation})
+	if !d.Retiring || count(e, NeedBYE) != 1 {
+		t.Fatal("timeout cleanup obligation")
+	}
+	d, e = dialogStep(t, d, DialogInput{Kind: DialogLocalRequest, Now: 33001, Method: sip.BYE, Branch: "z9hG4bK-timeout-bye"})
+	if d.LocalBye == nil || count(e, StartTransaction) != 1 {
+		t.Fatal("timeout BYE could not execute")
+	}
+}
+
+func TestPortableLocalByeCannotReopenOnLateInviteCompletion(t *testing.T) {
+	d := clientDialog(t)
+	d, _ = dialogStep(t, d, DialogInput{Kind: DialogLocalACK, Now: 1, Branch: "z9hG4bK-first-ack"})
+	d, _ = dialogStep(t, d, DialogInput{Kind: DialogLocalRequest, Now: 2, Method: sip.INVITE, Branch: "z9hG4bK-reinvite"})
+	pending := d.LocalInvite.Request
+	d, _ = dialogStep(t, d, DialogInput{Kind: DialogLocalRequest, Now: 3, Method: sip.BYE, Branch: "z9hG4bK-local-bye"})
+	bye := *d.LocalBye
+	d, _ = dialogStep(t, d, DialogInput{Kind: DialogReceiveResponse, Now: 4, Message: reply(t, pending, 200, d.RemoteTag)})
+	d, _ = dialogStep(t, d, DialogInput{Kind: DialogLocalACK, Now: 5, Branch: "z9hG4bK-late-ack"})
+	if !d.Retiring || d.Phase != DialogTerminating {
+		t.Fatal("late ACK reopened terminating dialog")
+	}
+	_, _, err := StepDialog(d, DialogInput{Kind: DialogLocalRequest, Now: 6, Method: sip.INFO, Branch: "z9hG4bK-after-bye"})
+	if err == nil {
+		t.Fatal("new request admitted during BYE")
+	}
+	_, _, err = StepDialog(d, DialogInput{Kind: DialogReceiveRequest, Now: 6, Message: peerRequest(t, d, sip.INVITE, 2, "z9hG4bK-peer-resume")})
+	if err == nil {
+		t.Fatal("peer re-INVITE admitted during BYE")
+	}
+	d, _ = dialogStep(t, d, DialogInput{Kind: DialogReceiveResponse, Now: 7, Message: reply(t, bye, 500, d.RemoteTag)})
+	if d.Phase != DialogEnded || !d.Retiring {
+		t.Fatal("failed BYE reopened dialog")
+	}
+}
+
+func TestPortableCancelledSuccessfulForkACKThenBye(t *testing.T) {
+	d := clientDialog(t)
+	d, e := dialogStep(t, d, DialogInput{Kind: DialogCancel, Now: 1})
+	if count(e, NeedACK) != 1 || !d.Retiring {
+		t.Fatal("cancelled success missing ACK")
+	}
+	d, e = dialogStep(t, d, DialogInput{Kind: DialogLocalACK, Now: 2, Branch: "z9hG4bK-cleanup-ack"})
+	if len(e) != 2 || e[0].Kind != Send || e[1].Kind != NeedBYE {
+		t.Fatal("cleanup ACK/BYE ordering")
+	}
+	d, e = dialogStep(t, d, DialogInput{Kind: DialogLocalRequest, Now: 3, Method: sip.BYE, Branch: "z9hG4bK-cleanup-bye"})
+	if count(e, StartTransaction) != 1 || d.LocalBye == nil {
+		t.Fatal("cleanup BYE not allocated")
+	}
+	_, _, err := StepDialog(d, DialogInput{Kind: DialogLocalRequest, Now: 4, Method: sip.BYE, Branch: "z9hG4bK-second-bye"})
+	if err == nil {
+		t.Fatal("second logical BYE allocated")
+	}
+}
+
+func TestPortableForksRetainIndependentTargetsAndACK(t *testing.T) {
+	o := origin(t, sip.INVITE, "tls")
+	one := reply(t, o, 200, "branch-one")
+	two := mutate(t, reply(t, o, 200, "branch-two"), func(v sip.Message) { v.(*sip.Response).Contact().Address.Host = "other.example.test" })
+	a, e := NewDialog(UAC, o, one, DefaultTimers())
+	if e != nil {
+		t.Fatal(e)
+	}
+	b, e := NewDialog(UAC, o, two, DefaultTimers())
+	if e != nil {
+		t.Fatal(e)
+	}
+	a, _ = dialogStep(t, a, DialogInput{Kind: DialogLocalACK, Now: 1, Branch: "z9hG4bK-one-ack"})
+	b, _ = dialogStep(t, b, DialogInput{Kind: DialogCancel, Now: 2})
+	if a.Target == b.Target || a.RemoteTag == b.RemoteTag || a.Phase != DialogConfirmed || !b.Retiring {
+		t.Fatal("fork state leaked across children")
+	}
+}
+
+func TestPortableLooseAndStrictRouting(t *testing.T) {
+	d := clientDialog(t)
+	d.Routes = []string{"<sip:proxy.example.test:5080;lr>", "<sip:last.example.test:5081;lr>"}
+	m, e := BuildDialogRequest(d, sip.BYE, d.LocalCSeq+1, nil, "z9hG4bK-loose")
+	if e != nil {
+		t.Fatal(e)
+	}
+	r, _ := testRequest(m)
+	if r.Recipient.String() != d.Target || m.Destination() != "proxy.example.test:5080" || len(r.GetHeaders("Route")) != 2 {
+		t.Fatal("loose routing")
+	}
+	d.Routes = []string{"<sip:strict.example.test:5080>", "<sip:next.example.test:5081;lr>"}
+	m, e = BuildDialogRequest(d, sip.BYE, d.LocalCSeq+1, nil, "z9hG4bK-strict")
+	if e != nil {
+		t.Fatal(e)
+	}
+	r, _ = testRequest(m)
+	routes := r.GetHeaders("Route")
+	if r.Recipient.Host != "strict.example.test" || len(routes) != 2 || routes[1].Value() != "<"+d.Target+">" {
+		t.Fatal("strict routing lost original target")
+	}
+}
+
+func TestPortableEarlyRouteSetIsRecomputedOnlyForInitialSuccess(t *testing.T) {
+	o := origin(t, sip.INVITE, "tls")
+	early := mutate(t, reply(t, o, 180, "remote-tag"), func(v sip.Message) { v.AppendHeader(sip.NewHeader("Record-Route", "<sip:early.example.test:5061;lr>")) })
+	d, err := NewDialog(UAC, o, early, DefaultTimers())
+	if err != nil {
+		t.Fatal(err)
+	}
+	final := mutate(t, reply(t, o, 200, "remote-tag"), func(v sip.Message) { v.AppendHeader(sip.NewHeader("Record-Route", "<sip:final.example.test:5061;lr>")) })
+	d, _ = dialogStep(t, d, DialogInput{Kind: DialogReceiveResponse, Now: 1, Message: final})
+	if len(d.Routes) != 1 || d.Routes[0] != "<sip:final.example.test:5061;lr>" {
+		t.Fatal("early route set retained after initial 2xx")
+	}
+	d, _ = dialogStep(t, d, DialogInput{Kind: DialogLocalACK, Now: 2, Branch: "z9hG4bK-final-ack"})
+	d, _ = dialogStep(t, d, DialogInput{Kind: DialogLocalRequest, Now: 3, Method: sip.INVITE, Branch: "z9hG4bK-refresh"})
+	refresh := mutate(t, reply(t, d.LocalInvite.Request, 200, "remote-tag"), func(v sip.Message) {
+		v.AppendHeader(sip.NewHeader("Record-Route", "<sip:bad-refresh.example.test:5061;lr>"))
+	})
+	d, _ = dialogStep(t, d, DialogInput{Kind: DialogReceiveResponse, Now: 4, Message: refresh})
+	if d.Routes[0] != "<sip:final.example.test:5061;lr>" {
+		t.Fatal("target refresh changed fixed route set")
+	}
+}
+
+func TestPortableOfferRequiresActualACKAnswerAndEarlyAnswerDoesNotBecomeNewOffer(t *testing.T) {
+	o := origin(t, sip.INVITE, "tls")
+	offer, err := BuildResponseWithHeaders(o, 200, "OK", []byte("v=0\r\n"), "remote-tag", "sip:phone@192.0.2.2:5061", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	d, err := NewDialog(UAC, o, offer, DefaultTimers())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if d.Offer != RemoteOfferInACK {
+		t.Fatal("remote offer not retained")
+	}
+	if _, _, err = StepDialog(d, DialogInput{Kind: DialogLocalACK, Now: 1, Branch: "z9hG4bK-empty", Answer: true}); err == nil {
+		t.Fatal("flag substituted for missing wire answer")
+	}
+	d, _ = dialogStep(t, d, DialogInput{Kind: DialogLocalACK, Now: 1, Branch: "z9hG4bK-answer", Body: []byte("v=0\r\n")})
+	if d.Offer != NoOffer {
+		t.Fatal("answer not consumed")
+	}
+	o = mutate(t, o, func(v sip.Message) {
+		v.SetBody([]byte("v=0\r\n"))
+		v.AppendHeader(sip.NewHeader("Content-Type", "application/sdp"))
+	})
+	early, err := BuildResponseWithHeaders(o, 183, "Progress", []byte("v=0\r\n"), "remote-tag", "sip:phone@192.0.2.2:5061", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	d, err = NewDialog(UAS, o, early, DefaultTimers())
+	if err != nil {
+		t.Fatal(err)
+	}
+	d, _ = dialogStep(t, d, DialogInput{Kind: DialogSendResponse, Now: 1, Message: early})
+	final, err := BuildResponseWithHeaders(o, 200, "OK", []byte("v=0\r\n"), "remote-tag", "sip:phone@192.0.2.2:5061", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	d, _ = dialogStep(t, d, DialogInput{Kind: DialogSendResponse, Now: 2, Message: final})
+	if d.Offer != NoOffer {
+		t.Fatal("repeated early answer became a new offer")
+	}
+}
+
+func TestPortableRejectsCorruptRestoredDialog(t *testing.T) {
+	s := clientDialog(t)
+	for name, change := range map[string]func(*Dialog){"phase": func(v *Dialog) { v.Phase = "future" }, "offer": func(v *Dialog) { v.Offer = "future" }, "version": func(v *Dialog) { v.Version++ }, "ended-unfenced": func(v *Dialog) { v.Phase = DialogEnded; v.Retiring = false }} {
+		t.Run(name, func(t *testing.T) {
+			bad := s.Clone()
+			change(&bad)
+			if _, e, err := StepDialog(hydrated(t, bad), DialogInput{Kind: DialogLocalACK, Now: 1, Branch: "z9hG4bK-no-restore-side-effect"}); err == nil || len(e) != 0 {
+				t.Fatal("invalid restored dialog emitted effects")
+			}
+		})
+	}
+}
diff --git a/sip/portable/immutable.go b/sip/portable/immutable.go
new file mode 100644
index 0000000..c0d0f9e
--- /dev/null
+++ b/sip/portable/immutable.go
@@ -0,0 +1,796 @@
+package portable
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/json"
+	"errors"
+	"io"
+	"math"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"unsafe"
+
+	"github.com/emiago/sipgo/sip"
+)
+
+// Message is an owned immutable SIP value. Its zero value is an absent message.
+// Copies share only private immutable evidence; no parsed SIP graph is retained.
+// Restored wire is validated lazily when consumed, not while unrelated state is read.
+var errMissingIdentity = errors.New("missing SIP identity")
+
+type Message struct{ data *messageData }
+
+type messageData struct {
+	wire                           []byte
+	transport, source, destination string
+	once                           sync.Once
+	frozen                         *frozenMessage
+	err                            error
+	retained                       atomic.Int64
+}
+
+// MessageFacts contains only scalar, immutable protocol and projection facts.
+// Transaction keys retain their separate native validation through the key methods.
+type MessageFacts struct {
+	IsRequest                                                            bool
+	Method                                                               sip.RequestMethod
+	Status                                                               int
+	Reason, URI, CallID, FromTag, ToTag                                  string
+	FromURI, ToURI, ContactURI, ContactHostPort                          string
+	HasContact                                                           bool
+	CSeq                                                                 uint32
+	CSeqMethod                                                           sip.RequestMethod
+	ViaHost, ViaTransport, ViaProtocol, ViaVersion, ViaBranch, ViaSentBy string
+	ViaPort                                                              int
+	BodyLength                                                           int
+	SDP                                                                  bool
+}
+
+// frozenMessage retains compact construction fields, not a sip.Request/Response.
+// Params and URIs are privately owned and only copied into mutable builders.
+// Extension and repeated headers remain ordered strings for exact projection.
+// orderedConstruction is allocated only for repeated singleton/Contact fields.
+// The common one-header case uses the selected facts already held below.
+type orderedConstruction struct {
+	from    []sip.FromHeader
+	to      []sip.ToHeader
+	callID  []sip.CallIDHeader
+	cseq    []sip.CSeqHeader
+	contact []sip.ContactHeader
+}
+
+type frozenMessage struct {
+	facts                           MessageFacts
+	nativeErr                       error
+	ordered                         *orderedConstruction
+	canonical                       bool
+	version                         string
+	recipient                       sip.Uri
+	from                            sip.FromHeader
+	to                              sip.ToHeader
+	via                             sip.ViaHeader
+	vias                            []sip.ViaHeader
+	contact                         *sip.ContactHeader
+	headers                         []Header
+	body                            []byte
+	clientKey, serverKey, cancelKey string
+	clientErr, serverErr, cancelErr error
+}
+
+func ownParams(in sip.HeaderParams) sip.HeaderParams {
+	if in == nil {
+		return nil
+	}
+	out := make(sip.HeaderParams, len(in))
+	for i, v := range in {
+		out[i] = sip.HeaderKV{K: strings.Clone(v.K), V: strings.Clone(v.V)}
+	}
+	return out
+}
+func ownURI(in sip.Uri) sip.Uri { return in.CloneOwned() }
+func ownFrom(in *sip.FromHeader) sip.FromHeader {
+	return sip.FromHeader{DisplayName: strings.Clone(in.DisplayName), Address: ownURI(in.Address), Params: ownParams(in.Params)}
+}
+func ownTo(in *sip.ToHeader) sip.ToHeader {
+	return sip.ToHeader{DisplayName: strings.Clone(in.DisplayName), Address: ownURI(in.Address), Params: ownParams(in.Params)}
+}
+func ownVia(in *sip.ViaHeader) sip.ViaHeader {
+	return sip.ViaHeader{ProtocolName: strings.Clone(in.ProtocolName), ProtocolVersion: strings.Clone(in.ProtocolVersion), Transport: strings.Clone(in.Transport), Host: strings.Clone(in.Host), Port: in.Port, Params: ownParams(in.Params)}
+}
+func ownContact(in *sip.ContactHeader) *sip.ContactHeader {
+	if in == nil {
+		return nil
+	}
+	return &sip.ContactHeader{DisplayName: strings.Clone(in.DisplayName), Address: ownURI(in.Address), Params: ownParams(in.Params)}
+}
+
+// ParseMessage is the raw-wire trust boundary. Each value parses at most once.
+func ParseMessage(wire []byte, transport, source, destination string) (Message, error) {
+	m := RestoreMessage(wire, transport, source, destination)
+	_, err := m.prepare()
+	return m, err
+}
+
+// FreezeMessage accepts the original parser result for these exact wire bytes.
+// The caller must own the same observed frame and must not pair independently
+// supplied wire/metadata with a parsed object. Untrusted wire uses ParseMessage.
+// All aliases to the parser, frame and metadata are severed before returning.
+func FreezeMessage(wire []byte, parsed sip.Message, transport, source, destination string) (Message, error) {
+	m := RestoreMessage(wire, transport, source, destination)
+	m.data.once.Do(func() { m.data.frozen, m.data.err = freeze(parsed, transport, false); m.data.addFrozenBytes() })
+	_, err := m.prepare()
+	return m, err
+}
+
+// RestoreMessage maps the existing serialized wire shape without eagerly parsing
+// unused messages. The opaque holder belongs to this operation; no parsed cache is
+// serialized or shared through a process-global lookup.
+func RestoreMessage(wire []byte, transport, source, destination string) Message {
+	d := &messageData{wire: bytes.Clone(wire), transport: strings.Clone(transport), source: strings.Clone(source), destination: strings.Clone(destination)}
+	d.retained.Store(int64(unsafe.Sizeof(*d) + uintptr(cap(d.wire)+len(transport)+len(source)+len(destination))))
+	return Message{data: d}
+}
+func (m Message) prepareFacts() (*frozenMessage, error) {
+	if m.data == nil {
+		return nil, errors.New("empty SIP message")
+	}
+	m.data.once.Do(func() {
+		parsed, err := sip.ParseMessage(m.data.wire)
+		if err != nil {
+			m.data.err = err
+			return
+		}
+		m.data.frozen, m.data.err = freeze(parsed, m.data.transport, false)
+		m.data.addFrozenBytes()
+	})
+	return m.data.frozen, m.data.err
+}
+func (m Message) prepare() (*frozenMessage, error) {
+	f, err := m.prepareFacts()
+	if err != nil {
+		return nil, err
+	}
+	if f.nativeErr != nil {
+		return nil, f.nativeErr
+	}
+	return f, nil
+}
+func (m Message) prepareObserved() (*frozenMessage, error) {
+	f, err := m.prepareFacts()
+	if err != nil {
+		if errors.Is(err, errMissingIdentity) {
+			return nil, errors.New("missing mandatory SIP identity")
+		}
+		return nil, err
+	}
+	if f.facts.IsRequest && f.clientErr != nil {
+		return nil, errors.New("RFC 3261 Via branch required")
+	}
+	return f, nil
+}
+
+func constructionHeaders(in []sip.Header) ([]sip.Header, error) {
+	var out []sip.Header
+	for _, h := range in {
+		switch h.(type) {
+		case *sip.ViaHeader, *sip.FromHeader, *sip.ToHeader, *sip.ContactHeader, *sip.CSeqHeader, *sip.MaxForwardsHeader, *sip.ContentLengthHeader, *sip.ContentTypeHeader, *sip.RouteHeader, *sip.RecordRouteHeader, *sip.ReferToHeader, *sip.ReferredByHeader:
+			out = append(out, h)
+		case *sip.CallIDHeader:
+			value := strings.TrimSpace(h.Value())
+			if value == "" {
+				return nil, errors.New("empty Call-ID body")
+			}
+			if value != h.Value() {
+				owned := sip.CallIDHeader(value)
+				h = &owned
+			}
+			out = append(out, h)
+		default:
+			parser := sip.HeadersParser(sip.DefaultHeadersParser())
+			if _, known := parser[strings.ToLower(h.Name())]; !known {
+				if trimmed := strings.TrimSpace(h.Value()); trimmed != h.Value() {
+					h = sip.NewHeader(h.Name(), trimmed)
+				}
+				out = append(out, h)
+				continue
+			}
+			var err error
+			out, err = parser.ParseHeader(out, []byte(h.Name()+": "+h.Value()))
+			if err != nil {
+				return nil, err
+			}
+		}
+	}
+	return out, nil
+}
+
+func structuredHeaderView(v sip.Message, headers []sip.Header, transport string) sip.Message {
+	var out sip.Message
+	switch input := v.(type) {
+	case *sip.Request:
+		request := sip.NewRequest(sip.RequestMethod(strings.ToUpper(string(input.Method))), input.Recipient)
+		request.SipVersion = input.SipVersion
+		out = request
+	case *sip.Response:
+		response := sip.NewResponse(input.StatusCode, input.Reason)
+		response.SipVersion = input.SipVersion
+		out = response
+	}
+	for _, h := range headers {
+		out.AppendHeader(h)
+	}
+	out.SetBody(v.Body())
+	out.SetTransport(strings.ToUpper(transport))
+	out.SetSource(v.Source())
+	out.SetDestination(v.Destination())
+	return out
+}
+
+func freeze(v sip.Message, transport string, structured bool) (*frozenMessage, error) {
+	if v == nil {
+		return nil, errMissingIdentity
+	}
+	originalHeaders := v.(interface{ Headers() []sip.Header }).Headers()
+	headers := originalHeaders
+	if structured {
+		var err error
+		headers, err = constructionHeaders(headers)
+		if err != nil {
+			return nil, err
+		}
+		v = structuredHeaderView(v, headers, transport)
+	}
+	if v.CallID() == nil || v.From() == nil || v.To() == nil || v.CSeq() == nil || v.Via() == nil {
+		return nil, errMissingIdentity
+	}
+	var nativeErr error
+	if v.CSeq().SeqNo > math.MaxInt32 || v.CallID().Value() == "" {
+		nativeErr = errors.New("invalid CSeq or Call-ID")
+	} else if transport != "udp" && transport != "tcp" && transport != "tls" {
+		nativeErr = errors.New("observed transport required")
+	}
+	r, isRequest := v.(*sip.Request)
+	if nativeErr == nil && isRequest && v.CSeq().MethodName != r.Method {
+		nativeErr = errors.New("CSeq method mismatch")
+	}
+	view := v.(interface {
+		Headers() []sip.Header
+		Contact() *sip.ContactHeader
+	})
+	f := &frozenMessage{nativeErr: nativeErr, from: ownFrom(v.From()), to: ownTo(v.To()), via: ownVia(v.Via()), contact: ownContact(view.Contact()), body: bytes.Clone(v.Body())}
+	f.facts = MessageFacts{IsRequest: isRequest, Method: v.CSeq().MethodName, CallID: strings.Clone(v.CallID().Value()), FromTag: tag(f.from.Params), ToTag: tag(f.to.Params), FromURI: f.from.Address.String(), ToURI: f.to.Address.String(), CSeq: v.CSeq().SeqNo, CSeqMethod: sip.RequestMethod(strings.Clone(string(v.CSeq().MethodName))), ViaHost: f.via.Host, ViaPort: f.via.Port, ViaTransport: f.via.Transport, ViaProtocol: f.via.ProtocolName, ViaVersion: f.via.ProtocolVersion, ViaBranch: f.via.Params.GetOr("branch", ""), ViaSentBy: f.via.SentBy(), BodyLength: len(f.body)}
+	f.facts.Method = f.facts.CSeqMethod
+	if isRequest {
+		f.version = strings.Clone(r.SipVersion)
+		f.recipient = ownURI(r.Recipient)
+		if r.Method != f.facts.CSeqMethod {
+			f.facts.Method = sip.RequestMethod(strings.Clone(string(r.Method)))
+		}
+		f.facts.URI = f.recipient.String()
+	} else if response, ok := v.(*sip.Response); ok {
+		if structured && strings.ContainsAny(response.Reason, "\r\n") {
+			return nil, errors.New("invalid reason phrase")
+		}
+		f.version = strings.Clone(response.SipVersion)
+		f.facts.Status = response.StatusCode
+		f.facts.Reason = strings.Clone(response.Reason)
+	} else {
+		return nil, errors.New("request or response required")
+	}
+	if f.contact != nil {
+		f.facts.HasContact = true
+		f.facts.ContactURI = f.contact.Address.String()
+		f.facts.ContactHostPort = f.contact.Address.HostPort()
+	}
+	f.canonical = structured && len(headers) == len(originalHeaders)
+	if f.canonical {
+		for i, h := range headers {
+			original := originalHeaders[i]
+			if h.Name() != original.Name() || h.Value() != original.Value() {
+				f.canonical = false
+				break
+			}
+		}
+	}
+	var fromCount, toCount, idCount, cseqCount, contactCount int
+	for _, h := range headers {
+		switch h.(type) {
+		case *sip.FromHeader:
+			fromCount++
+		case *sip.ToHeader:
+			toCount++
+		case *sip.CallIDHeader:
+			idCount++
+		case *sip.CSeqHeader:
+			cseqCount++
+		case *sip.ContactHeader:
+			contactCount++
+		}
+	}
+	if fromCount > 1 || toCount > 1 || idCount > 1 || cseqCount > 1 || contactCount > 1 {
+		f.ordered = &orderedConstruction{}
+		if fromCount > 1 {
+			f.ordered.from = make([]sip.FromHeader, 0, fromCount)
+		}
+		if toCount > 1 {
+			f.ordered.to = make([]sip.ToHeader, 0, toCount)
+		}
+		if idCount > 1 {
+			f.ordered.callID = make([]sip.CallIDHeader, 0, idCount)
+		}
+		if cseqCount > 1 {
+			f.ordered.cseq = make([]sip.CSeqHeader, 0, cseqCount)
+		}
+		if contactCount > 1 {
+			f.ordered.contact = make([]sip.ContactHeader, 0, contactCount)
+		}
+	}
+	f.headers = make([]Header, 0, len(headers))
+	contentTypes := 0
+	contentType := ""
+	for _, h := range headers {
+		if ordered := f.ordered; ordered != nil {
+			switch value := h.(type) {
+			case *sip.FromHeader:
+				if fromCount > 1 {
+					ordered.from = append(ordered.from, ownFrom(value))
+				}
+			case *sip.ToHeader:
+				if toCount > 1 {
+					ordered.to = append(ordered.to, ownTo(value))
+				}
+			case *sip.CallIDHeader:
+				if idCount > 1 {
+					ordered.callID = append(ordered.callID, sip.CallIDHeader(strings.Clone(value.Value())))
+				}
+			case *sip.CSeqHeader:
+				if cseqCount > 1 {
+					ordered.cseq = append(ordered.cseq, sip.CSeqHeader{SeqNo: value.SeqNo, MethodName: sip.RequestMethod(strings.Clone(string(value.MethodName)))})
+				}
+			case *sip.ContactHeader:
+				if contactCount > 1 {
+					ordered.contact = append(ordered.contact, *ownContact(value))
+				}
+			}
+		}
+		if via, ok := h.(*sip.ViaHeader); ok {
+			f.vias = append(f.vias, ownVia(via))
+		}
+		name, value := strings.Clone(h.Name()), strings.Clone(h.Value())
+		f.headers = append(f.headers, Header{Name: name, Value: value})
+		if strings.EqualFold(name, "Content-Type") {
+			contentTypes++
+			contentType = value
+		}
+	}
+	f.facts.SDP = len(f.body) > 0 && contentTypes == 1 && strings.EqualFold(strings.TrimSpace(strings.Split(contentType, ";")[0]), "application/sdp")
+	f.clientKey, f.clientErr = sip.ClientTxKeyMake(v)
+	f.serverKey, f.serverErr = sip.ServerTxKeyMake(v)
+	f.cancelKey, f.cancelErr = f.serverKey, f.serverErr
+	if v.CSeq().MethodName == sip.CANCEL {
+		if isRequest {
+			copy := r.Clone()
+			copy.CSeq().MethodName = sip.INVITE
+			f.cancelKey, f.cancelErr = sip.ServerTxKeyMake(copy)
+		} else {
+			copy := v.(*sip.Response).Clone()
+			copy.CSeq().MethodName = sip.INVITE
+			f.cancelKey, f.cancelErr = sip.ServerTxKeyMake(copy)
+		}
+	}
+	return f, nil
+}
