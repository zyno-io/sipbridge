+	m, e := BuildResponseWithHeaders(o, 200, "OK", []byte("accepted"), "chosen-tag", "sip:controller@192.0.2.1:5061", []Header{{Name: "Content-Type", Value: "text/plain"}, {Name: "X-Test", Value: "kept"}})
