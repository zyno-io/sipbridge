+	in.URI = "sip:phone@example.test"
+	in.Transport = "tls"
+	in.LocalTag = "bad;injected=tag"
+	if _, e = BuildInitialRequest(in); e == nil {
+		t.Fatal("invalid tag admitted")
+	}
+}
