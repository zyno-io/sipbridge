+package portable
+
+import (
+	"bytes"
+	"encoding/json"
+	"testing"
+
+	"github.com/emiago/sipgo/sip"
+)
+
+func origin(t *testing.T, method sip.RequestMethod, transport string) Message {
+	t.Helper()
+	m, err := BuildInitialRequest(InitialRequest{Method: method, URI: "sip:phone@example.test;user=phone?Subject=test", From: "<sip:controller@example.test>", CallID: "portable-call", LocalTag: "local-tag", Branch: "z9hG4bK-original", CSeq: 121787510, Advertise: "192.0.2.1:5061", Contact: "<sip:controller@192.0.2.1:5061;transport=" + transport + ">", Transport: transport})
+	if err != nil {
+		t.Fatal(err)
+	}
+	m = RestoreMessage(m.WireBytes(), m.Transport(), "192.0.2.1:5061", "192.0.2.2:5061")
+	return m
+}
+func reply(t *testing.T, m Message, status int, remoteTag string) Message {
+	t.Helper()
+	v, err := BuildResponseWithHeaders(m, status, "test", nil, remoteTag, "<sip:phone@192.0.2.2:5061>", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return v
+}
+func hydrated[T any](t *testing.T, s T) T {
+	t.Helper()
+	b, e := json.Marshal(s)
+	if e != nil {
+		t.Fatal(e)
+	}
+	var v T
+	if e = json.Unmarshal(b, &v); e != nil {
+		t.Fatal(e)
+	}
+	return v
+}
+func step(t *testing.T, s Transaction, in Input) (Transaction, []Effect) {
+	t.Helper()
+	before, _ := json.Marshal(s)
+	next, effects, err := StepTransaction(hydrated(t, s), in)
+	if err != nil {
+		t.Fatal(err)
+	}
+	after, _ := json.Marshal(s)
+	if !bytes.Equal(before, after) {
+		t.Fatal("input state mutated")
+	}
+	return hydrated(t, next), effects
+}
+func count(e []Effect, k EffectKind) int {
+	n := 0
+	for _, v := range e {
+		if v.Kind == k {
+			n++
+		}
+	}
+	return n
+}
+func sent(e []Effect) []Message {
+	var a []Message
+	for _, v := range e {
+		if v.Kind == Send && v.Message != nil {
+			a = append(a, *v.Message)
+		}
+	}
+	return a
+}
+func tx(t *testing.T, f Family, m Message) Transaction {
+	t.Helper()
+	s, e := NewTransaction(f, m, DefaultTimers(), "remote-tag")
+	if e != nil {
+		t.Fatal(e)
+	}
+	return s
+}
+
+func TestPortableInviteClientHydratesEveryTransition(t *testing.T) {
+	m := origin(t, sip.INVITE, "udp")
+	s := tx(t, InviteClient, m)
+	s, e := step(t, s, Input{Kind: Start, Now: 1000})
+	if s.Phase != Calling || s.Timers[TimerA].At != 1500 || s.Timers[TimerB].At != 33000 || count(e, Send) != 1 {
+		t.Fatalf("start: %+v", s)
+	}
+	s, e = step(t, s, Input{Kind: TimerFired, Timer: TimerA, Generation: s.Timers[TimerA].Generation, Now: 1500})
+	if count(e, Send) != 1 || s.Timers[TimerA].At != 2500 {
+		t.Fatal("A retransmission lost")
+	}
+	s, _ = step(t, s, Input{Kind: ReceiveResponse, Message: reply(t, m, 180, "remote-tag"), Now: 1700})
+	if s.Phase != Proceeding || s.Timers[TimerA].Active || s.Timers[TimerB].Active {
+		t.Fatal("provisional did not end calling timers")
+	}
+	final := reply(t, m, 200, "remote-tag")
+	s, _ = step(t, s, Input{Kind: ReceiveResponse, Message: final, Now: 1800})
+	if s.Phase != Accepted || s.Timers[TimerM].At != 33800 {
+		t.Fatal("accepted retention missing")
+	}
+	s, e = step(t, s, Input{Kind: ReceiveResponse, Message: final, Now: 1900})
+	if count(e, ReportResponse) != 1 || !e[0].Replay {
+		t.Fatal("successful retransmission not reported")
+	}
+	s, _ = step(t, s, Input{Kind: TransportFailure, Error: "socket", Now: 2000})
+	if s.Phase != Accepted {
+		t.Fatal("accepted state lost after delivery error")
+	}
+	s, _ = step(t, s, Input{Kind: TimerFired, Timer: TimerM, Generation: s.Timers[TimerM].Generation, Now: 33800})
+	if s.Phase != Terminated {
+		t.Fatal("M did not retire")
+	}
+}
+
+func TestPortableInviteRejectedACKIsStable(t *testing.T) {
+	m := origin(t, sip.INVITE, "udp")
+	s, _ := step(t, tx(t, InviteClient, m), Input{Kind: Start, Now: 1000})
+	final := reply(t, m, 486, "remote-tag")
+	s, e := step(t, s, Input{Kind: ReceiveResponse, Message: final, Now: 1100})
+	if s.Phase != Completed || s.ACK == nil || count(e, Send) != 1 {
+		t.Fatal("non-2xx ACK missing")
+	}
+	first := bytes.Clone(s.ACK.WireBytes())
+	s, e = step(t, s, Input{Kind: ReceiveResponse, Message: final, Now: 1101})
+	if len(sent(e)) != 1 || !bytes.Equal(sent(e)[0].WireBytes(), first) {
+		t.Fatal("ACK replay allocated new identity")
+	}
+	_, effects, err := StepTransaction(s, Input{Kind: ReceiveResponse, Message: mutate(t, final, func(v sip.Message) { v.CSeq().SeqNo++ }), Now: 1200})
+	if err == nil || len(effects) != 0 {
+		t.Fatal("wrong CSeq matched")
+	}
+	if s.Timers[TimerD].At != 33100 {
+		t.Fatal("D deadline reset")
+	}
+}
+
+func TestPortableNonInviteFamiliesAndTransportProfiles(t *testing.T) {
+	for _, network := range []string{"udp", "tcp", "tls"} {
+		t.Run(network, func(t *testing.T) {
+			m := origin(t, sip.OPTIONS, network)
+			s, e := step(t, tx(t, NonInviteClient, m), Input{Kind: Start, Now: 1000})
+			if count(e, Send) != 1 || !s.Timers[TimerF].Active {
+				t.Fatal("non-INVITE start")
+			}
+			if s.Timers[TimerE].Active != (network == "udp") {
+				t.Fatal("transport class lost")
+			}
+			if network == "udp" {
+				s, _ = step(t, s, Input{Kind: ReceiveResponse, Message: reply(t, m, 100, ""), Now: 1100})
+				s, e = step(t, s, Input{Kind: TimerFired, Timer: TimerE, Generation: s.Timers[TimerE].Generation, Now: 1500})
+				if count(e, Send) != 1 || s.Timers[TimerE].At != 5500 || s.Timers[TimerF].At != 33000 {
+					t.Fatal("E/F reset incorrectly")
+				}
+			}
+			s, _ = step(t, s, Input{Kind: ReceiveResponse, Message: reply(t, m, 200, "remote-tag"), Now: 2000})
+			if network == "udp" {
+				if s.Phase != Completed || s.Timers[TimerK].At != 7000 {
+					t.Fatal("K missing")
+				}
+			} else if s.Phase != Terminated {
+				t.Fatal("reliable NICT retention")
+			}
+			server, e := step(t, tx(t, NonInviteServer, m), Input{Kind: Start, Now: 1000})
+			if count(e, PresentRequest) != 1 {
+				t.Fatal("server presentation")
+			}
+			server, e = step(t, server, Input{Kind: SendResponse, Message: reply(t, m, 200, "remote-tag"), Now: 1200})
+			if count(e, Send) != 1 {
+				t.Fatal("server final")
+			}
+			if network == "udp" {
+				if server.Phase != Completed || server.Timers[TimerJ].At != 33200 {
+					t.Fatal("J missing")
+				}
+				server, e = step(t, server, Input{Kind: ReceiveRequest, Message: m, Now: 1300})
+				if count(e, Send) != 1 || count(e, PresentRequest) != 0 {
+					t.Fatal("server replay reran policy")
+				}
+			} else if server.Phase != Terminated {
+				t.Fatal("reliable NIST retention")
+			}
+		})
+	}
+}
+
+func TestPortableServerTryingFinalAndACK(t *testing.T) {
+	m := origin(t, sip.INVITE, "udp")
+	s, e := step(t, tx(t, InviteServer, m), Input{Kind: Start, Now: 1000})
+	if count(e, PresentRequest) != 1 {
+		t.Fatal("presentation missing")
+	}
+	s, e = step(t, s, Input{Kind: TimerFired, Timer: TimerTrying, Generation: s.Timers[TimerTrying].Generation, Now: 1200})
+	if len(sent(e)) != 1 {
+		t.Fatal("Trying missing")
+	}
+	parsed, _ := testResponse(sent(e)[0])
+	if parsed.StatusCode != 100 || tag(parsed.To().Params) != "" {
+		t.Fatal("100 identity")
+	}
+	final := reply(t, m, 486, "remote-tag")
+	s, _ = step(t, s, Input{Kind: SendResponse, Message: final, Now: 1300})
+	if s.Timers[TimerH].At != 33300 {
+		t.Fatal("H missing")
+	}
+	ack, err := BuildNon2xxACK(m, final)
+	if err != nil {
+		t.Fatal(err)
+	}
+	s, e = step(t, s, Input{Kind: ReceiveRequest, Message: ack, Now: 1400})
+	if s.Phase != Confirmed || s.Timers[TimerG].Active || count(e, Acknowledged) != 1 {
+		t.Fatal("ACK not confirmed")
+	}
+	s, _ = step(t, s, Input{Kind: TimerFired, Timer: TimerI, Generation: s.Timers[TimerI].Generation, Now: 6400})
+	if s.Phase != Terminated {
+		t.Fatal("I not retired")
+	}
+}
+
+func TestPortableCancelIsItsOwnRetainedTransaction(t *testing.T) {
+	m := origin(t, sip.INVITE, "udp")
+	invite, _ := step(t, tx(t, InviteServer, m), Input{Kind: Start, Now: 1000})
+	cancel, err := BuildCancel(m)
+	if err != nil {
+		t.Fatal(err)
+	}
+	i, c, e, err := StepServerCancel(invite, nil, Input{Kind: ReceiveRequest, Message: cancel, Now: 1100})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if i.Phase != Completed || c.Phase != Completed || !i.Cancelled || c.Key == i.Key {
+		t.Fatal("cancel state not independent")
+	}
+	writes := sent(e)
+	if len(writes) != 2 {
+		t.Fatalf("want CANCEL200 then INVITE487, %+v", e)
+	}
+	first, _ := testResponse(writes[0])
+	second, _ := testResponse(writes[1])
+	if first.CSeq().MethodName != sip.CANCEL || first.StatusCode != 200 || second.StatusCode != 487 || tag(first.To().Params) != "remote-tag" || tag(second.To().Params) != "remote-tag" {
+		t.Fatal("cancel response identity/order")
+	}
+	_, replay := step(t, c, Input{Kind: ReceiveRequest, Message: cancel, Now: 7000})
+	if len(sent(replay)) != 1 {
+		t.Fatal("CANCEL replay lost independently of INVITE")
+	}
+	_, _, _, err = StepServerCancel(invite, nil, Input{Kind: ReceiveRequest, Message: mutate(t, cancel, func(v sip.Message) { *v.CallID() = "other" }), Now: 1100})
+	if err == nil {
+		t.Fatal("borrowed CANCEL branch accepted")
+	}
+	accepted, _ := step(t, invite, Input{Kind: SendResponse, Message: reply(t, m, 200, "remote-tag"), Now: 1100})
+	accepted, _, e, err = StepServerCancel(accepted, nil, Input{Kind: ReceiveRequest, Message: cancel, Now: 1101})
+	if err != nil || accepted.Phase != Accepted || len(sent(e)) != 1 {
+		t.Fatal("CANCEL replaced already-selected success")
+	}
+}
+
+func TestPortableClientCancellationWaitsForProvisional(t *testing.T) {
+	m := origin(t, sip.INVITE, "tls")
+	s, _ := step(t, tx(t, InviteClient, m), Input{Kind: Start, Now: 1})
+	s, e := step(t, s, Input{Kind: RequestCancel, Now: 2})
+	if !s.Cancelled || count(e, StartTransaction) != 0 {
+		t.Fatal("premature CANCEL")
+	}
+	s, e = step(t, s, Input{Kind: ReceiveResponse, Message: reply(t, m, 100, ""), Now: 3})
+	if !s.CancelSent || count(e, StartTransaction) != 1 {
+		t.Fatal("CANCEL not created")
+	}
+	s, e = step(t, s, Input{Kind: RequestCancel, Now: 4})
+	if count(e, StartTransaction) != 0 {
+		t.Fatal("duplicate CANCEL")
+	}
+}
+
+func TestPortableTimerGenerationAndInputImmutability(t *testing.T) {
+	m := origin(t, sip.OPTIONS, "udp")
+	s, _ := step(t, tx(t, NonInviteClient, m), Input{Kind: Start, Now: 1000})
+	s, e := step(t, s, Input{Kind: TimerFired, Timer: TimerE, Generation: 99, Now: 1500})
+	if len(e) != 0 || s.Timers[TimerE].At != 1500 {
+		t.Fatal("stale timer fired")
+	}
+	s, e = step(t, s, Input{Kind: TimerFired, Timer: TimerE, Generation: s.Timers[TimerE].Generation, Now: 1499})
+	if len(e) != 0 {
+		t.Fatal("early timer fired")
+	}
+	_, effects, err := StepTransaction(s, Input{Kind: ReceiveResponse, Message: mutate(t, reply(t, m, 200, "remote-tag"), func(v sip.Message) { v.From().Params.Add("tag", "attacker") }), Now: 1500})
+	if err == nil || len(effects) != 0 {
+		t.Fatal("mismatched identity produced effects")
+	}
+}
+
+func mutate(t *testing.T, m Message, fn func(sip.Message)) Message {
+	t.Helper()
+	v, e := sip.ParseMessage(m.WireBytes())
+	if e != nil {
+		t.Fatal(e)
+	}
+	fn(v)
+	m = wire(v, m.Transport(), m.Source(), m.Destination())
+	return m
+}
+
+func TestPortableRejectsCorruptRestoredTransaction(t *testing.T) {
+	s, _ := step(t, tx(t, InviteClient, origin(t, sip.INVITE, "tls")), Input{Kind: Start, Now: 1})
+	for name, change := range map[string]func(*Transaction){"family": func(v *Transaction) { v.Family = "future" }, "phase": func(v *Transaction) { v.Phase = "future" }, "key": func(v *Transaction) { v.Key = "borrowed" }, "transport": func(v *Transaction) { v.Reliable = false }, "version": func(v *Transaction) { v.Version++ }} {
+		t.Run(name, func(t *testing.T) {
+			bad := s.Clone()
+			change(&bad)
+			if _, e, err := StepTransaction(hydrated(t, bad), Input{Kind: TransportFailure, Now: 2}); err == nil || len(e) != 0 {
+				t.Fatal("invalid state emitted effects")
+			}
+		})
+	}
+}
diff --git a/sip/sip.go b/sip/sip.go
index 22dc839..4cf72a1 100644
--- a/sip/sip.go
+++ b/sip/sip.go
@@ -1,6 +1,7 @@
 package sip
 
 import (
+	"crypto/rand"
 	"fmt"
 	"os"
 	"strings"
@@ -61,9 +62,24 @@ func generateBranchStringWrite(sb *strings.Builder, n int) {
 	RandStringBytesMask(sb, n)
 }
 
+// GenerateTagN returns a cryptographically random SIP token with n characters.
+// Like crypto/rand.Read, entropy failure must not fall back to predictable tags.
 func GenerateTagN(n int) string {
 	sb := &strings.Builder{}
-	RandStringBytesMask(sb, n)
+	sb.Grow(n)
+	var buf [32]byte
+	for sb.Len() < n {
+		remaining := min(n-sb.Len(), len(buf))
+		if _, err := rand.Read(buf[:remaining]); err != nil {
+			panic(fmt.Errorf("generate SIP tag: %w", err))
+		}
+		for _, b := range buf[:remaining] {
+			// Rejection sampling avoids bias across the 62 token characters.
+			if idx := int(b & letterIdxMask); idx < len(letterBytes) {
+				sb.WriteByte(letterBytes[idx])
+			}
+		}
+	}
 	return sb.String()
 }
 
diff --git a/sip/tag_random_test.go b/sip/tag_random_test.go
new file mode 100644
index 0000000..5b3f8dd
--- /dev/null
+++ b/sip/tag_random_test.go
@@ -0,0 +1,32 @@
+package sip
+
+import (
+	"bytes"
+	"crypto/rand"
+	"testing"
+)
+
+func TestGenerateTagNUsesCryptoRandomness(t *testing.T) {
+	// These six-bit values exercise rejection of the two values outside the
+	// SIP token alphabet. The result must depend on crypto/rand, not math/rand.
+	old := rand.Reader
+	rand.Reader = bytes.NewReader([]byte{62, 63, 0, 61, 1, 60})
+	t.Cleanup(func() { rand.Reader = old })
+	if got := GenerateTagN(4); got != "0Z1Y" {
+		t.Fatalf("tag = %q, want crypto-random token 0Z1Y", got)
+	}
+}
+
+func TestGenerateTagNLengthAndAlphabet(t *testing.T) {
+	for _, n := range []int{0, 1, 16, 100} {
+		tag := GenerateTagN(n)
+		if len(tag) != n {
+			t.Fatalf("len(tag) = %d, want %d", len(tag), n)
+		}
+		for _, ch := range tag {
+			if !bytes.ContainsRune([]byte(letterBytes), ch) {
+				t.Fatalf("tag contains non-token character %q", ch)
+			}
+		}
+	}
+}
diff --git a/sip/transaction_cancel_context_test.go b/sip/transaction_cancel_context_test.go
new file mode 100644
index 0000000..45dfb8e
--- /dev/null
+++ b/sip/transaction_cancel_context_test.go
@@ -0,0 +1,102 @@
+package sip
+
+import (
+	"io"
+	"log/slog"
+	"net"
+	"sync"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+type cancelContextConnection struct {
+	mu        sync.Mutex
+	responses []*Response
+}
+
+func (c *cancelContextConnection) LocalAddr() net.Addr    { return &net.TCPAddr{} }
+func (c *cancelContextConnection) Ref(int) int            { return 1 }
+func (c *cancelContextConnection) TryClose() (int, error) { return 1, nil }
+func (c *cancelContextConnection) Close() error           { return nil }
+func (c *cancelContextConnection) WriteMsg(message Message) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.responses = append(c.responses, message.(*Response).Clone())
+	return nil
+}
+func (c *cancelContextConnection) snapshot() []*Response {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return append([]*Response(nil), c.responses...)
+}
+
+func TestServerTxCancelContextIdentity(t *testing.T) {
+	request, _, _ := testCreateInvite(t, "sip:bob@example.test", "TLS", "127.0.0.1:5061")
+	tx := NewServerTx("key", request, nil, slog.Default())
+	valid := request.Clone()
+	valid.Method = CANCEL
+	valid.CSeq().MethodName = CANCEL
+	valid.SetSource("192.0.2.2:5077")
+	valid.Via().Params.Add("received", "192.0.2.2")
+	valid.Via().Params.Add("rport", "5077")
+	require.True(t, tx.matchesCancelIdentity(valid), "reconnect may change source/rport")
+	for _, mutate := range []func(*Request){
+		func(r *Request) { id := CallIDHeader("different-call"); r.ReplaceHeader(&id) },
+		func(r *Request) { r.CSeq().SeqNo++ },
+		func(r *Request) { r.From().Params.Add("tag", "different-from") },
+		func(r *Request) { r.To().Params.Add("tag", "unexpected-to") },
+	} {
+		other := valid.Clone()
+		mutate(other)
+		require.False(t, tx.matchesCancelIdentity(other))
+	}
+}
+
+func TestTransactionLayerCancelBorrowedBranch(t *testing.T) {
+	logger := slog.New(slog.NewTextHandler(io.Discard, nil))
+	transport := NewTransportLayer(net.DefaultResolver, NewParser(), nil)
+	layer := NewTransactionLayer(transport, WithTransactionLayerLogger(logger))
+	t.Cleanup(layer.Close)
+	alice, _, _ := testCreateInvite(t, "sip:callee@example.test", "TLS", "127.0.0.1:5061")
+	alice.SetSource("127.0.0.1:5061")
+	aliceConnection := &cancelContextConnection{}
+	key, err := ServerTxKeyMake(alice)
+	require.NoError(t, err)
+	original := NewServerTx(key, alice, aliceConnection, logger)
+	require.NoError(t, original.Init())
+	layer.serverTransactions.put(key, original)
+	original.OnTerminate(func(key string, err error) { layer.serverTransactions.drop(key) })
+
+	bobConnection := &cancelContextConnection{}
+	transport.Pool("tls").Add("127.0.0.1:5077", bobConnection)
+	callbackCalled := false
+	layer.OnRequest(func(request *Request, tx *ServerTx) {
+		defer tx.Terminate()
+		callbackCalled = true
+		require.Equal(t, CANCEL, request.Method)
+		require.NoError(t, tx.Respond(NewResponseFromRequest(request, 481, "No matching request", nil)))
+	})
+	borrowed := alice.Clone()
+	borrowed.Method = CANCEL
+	borrowed.CSeq().MethodName = CANCEL
+	id := CallIDHeader("bobs-own-call")
+	borrowed.ReplaceHeader(&id)
+	borrowed.From().Params.Add("tag", "bobs-own-tag")
+	borrowed.SetSource("127.0.0.1:5077")
+	require.NoError(t, layer.handleRequest(borrowed))
+	require.True(t, callbackCalled, "identity mismatch follows unmatched CANCEL path")
+	require.Empty(t, aliceConnection.snapshot(), "borrowed branch cannot cancel Alice's INVITE")
+	rejected := bobConnection.snapshot()
+	require.Len(t, rejected, 1)
+	require.Equal(t, 481, rejected[0].StatusCode)
+	require.NoError(t, original.Err())
+
+	// The real identity still matches even over the replacement source flow.
+	legitimate := alice.Clone()
+	legitimate.Method = CANCEL
+	legitimate.CSeq().MethodName = CANCEL
+	legitimate.SetSource("127.0.0.1:5077")
+	require.NoError(t, layer.handleRequest(legitimate))
+	require.Len(t, aliceConnection.snapshot(), 2, "valid cancellation still generates 200 and 487")
+}
diff --git a/sip/transaction_cancel_identity_test.go b/sip/transaction_cancel_identity_test.go
new file mode 100644
index 0000000..ede4668
--- /dev/null
+++ b/sip/transaction_cancel_identity_test.go
@@ -0,0 +1,170 @@
+package sip
+
+import (
+	"errors"
+	"io"
+	"log/slog"
+	"net"
+	"strconv"
+	"sync"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+type cancelIdentityConnection struct {
+	mu        sync.Mutex
+	responses []*Response
+}
+
+func (c *cancelIdentityConnection) LocalAddr() net.Addr    { return &net.TCPAddr{} }
+func (c *cancelIdentityConnection) Ref(n int) int          { return 1 }
+func (c *cancelIdentityConnection) TryClose() (int, error) { return 1, nil }
+func (c *cancelIdentityConnection) Close() error           { return nil }
+func (c *cancelIdentityConnection) WriteMsg(message Message) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.responses = append(c.responses, message.(*Response).Clone())
+	return nil
+}
+func (c *cancelIdentityConnection) snapshot() []*Response {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return append([]*Response(nil), c.responses...)
+}
+
+func cancelIdentityFixture(t *testing.T) (*TransactionLayer, *ServerTx, *Request, *cancelIdentityConnection) {
+	t.Helper()
+	request, _, _ := testCreateInvite(t, "sip:bob@example.test", "TLS", "127.0.0.1:5061")
+	connection := &cancelIdentityConnection{}
+	key, err := ServerTxKeyMake(request)
+	require.NoError(t, err)
+	tx := NewServerTx(key, request, connection, slog.New(slog.NewTextHandler(io.Discard, nil)))
+	require.NoError(t, tx.Init())
+	t.Cleanup(tx.Terminate)
+	layer := &TransactionLayer{serverTransactions: newTransactionStore[*ServerTx]()}
+	layer.serverTransactions.put(key, tx)
+	return layer, tx, request, connection
+}
+
+func matchingCancel(request *Request) *Request {
+	cancel := request.Clone()
+	cancel.Method = CANCEL
+	cancel.CSeq().MethodName = CANCEL
+	// The CANCEL retains its own received/source metadata after reconnect.
+	cancel.Via().Params.Add("received", "192.0.2.2")
+	cancel.Via().Params.Add("rport", "5077")
+	return cancel
+}
+
+func responseTag(response *Response) string {
+	tag, _ := response.To().Params.Get("tag")
+	return tag
+}
+
+func taggedResponse(request *Request, status int, tag string) *Response {
+	response := NewResponseFromRequest(request, status, "Test", nil)
+	response.To().Params.Add("tag", tag)
+	return response
+}
+
+func TestServerTxCancelResponseIdentity(t *testing.T) {
+	layer, tx, request, connection := cancelIdentityFixture(t)
+	provisional := taggedResponse(request, 183, "established-local-tag")
+	require.NoError(t, tx.Respond(provisional))
+	cancel := matchingCancel(request)
+	require.NoError(t, layer.handleRequest(cancel))
+	require.NoError(t, layer.handleRequest(cancel))
+	responses := connection.snapshot()
+	require.Len(t, responses, 4)
+	for _, response := range responses {
+		require.Equal(t, "established-local-tag", responseTag(response))
+	}
+	require.Equal(t, CANCEL, responses[1].CSeq().MethodName)
+	require.Equal(t, INVITE, responses[2].CSeq().MethodName)
+	require.Equal(t, 487, responses[2].StatusCode)
+	received, _ := responses[1].Via().Params.Get("received")
+	require.Equal(t, "192.0.2.2", received)
+	require.False(t, request.To().Params.Has("tag"), "original request is immutable")
+	require.Equal(t, "established-local-tag", responseTag(provisional))
+	require.ErrorIs(t, tx.Respond(taggedResponse(request, 200, "late-answer-tag")), ErrTransactionCanceled)
+	require.NoError(t, tx.Receive(request))
+	responses = connection.snapshot()
+	require.Equal(t, 487, responses[len(responses)-1].StatusCode, "late answer cannot replace cached 487")
+	require.Equal(t, "established-local-tag", responseTag(responses[len(responses)-1]))
+}
+
+func TestServerTxCancelBeforeTaggedResponse(t *testing.T) {
+	layer, tx, request, connection := cancelIdentityFixture(t)
+	require.NoError(t, tx.Respond(NewResponseFromRequest(request, 100, "Trying", nil)))
+	require.NoError(t, layer.handleRequest(matchingCancel(request)))
+	require.NoError(t, layer.handleRequest(matchingCancel(request)))
+	responses := connection.snapshot()
+	require.Empty(t, responseTag(responses[0]))
+	tag := responseTag(responses[1])
+	require.NotEmpty(t, tag)
+	for _, response := range responses[1:] {
+		require.Equal(t, tag, responseTag(response))
+	}
+}
+
+func TestServerTxCancelAfterFinal(t *testing.T) {
+	for _, status := range []int{200, 486} {
+		t.Run(strconv.Itoa(status), func(t *testing.T) {
+			layer, tx, request, connection := cancelIdentityFixture(t)
+			require.NoError(t, tx.Respond(taggedResponse(request, 183, "dialog-tag")))
+			require.NoError(t, tx.Respond(taggedResponse(request, status, "dialog-tag")))
+			require.NoError(t, layer.handleRequest(matchingCancel(request)))
+			require.NoError(t, layer.handleRequest(matchingCancel(request)))
+			responses := connection.snapshot()
+			require.Len(t, responses, 4)
+			for _, response := range responses {
+				require.Equal(t, "dialog-tag", responseTag(response))
+				require.NotEqual(t, 487, response.StatusCode)
+			}
+			require.Equal(t, status, tx.fsmResp.StatusCode)
+			require.Equal(t, CANCEL, responses[2].CSeq().MethodName)
+		})
+	}
+}
+
+func TestServerTxCancelConcurrentFinal(t *testing.T) {
+	for range 100 {
+		layer, tx, request, connection := cancelIdentityFixture(t)
+		require.NoError(t, tx.Respond(taggedResponse(request, 183, "dialog-tag")))
+		begin := make(chan struct{})
+		results := make(chan error, 2)
+		go func() { <-begin; results <- layer.handleRequest(matchingCancel(request)) }()
+		go func() { <-begin; results <- tx.Respond(taggedResponse(request, 200, "dialog-tag")) }()
+		close(begin)
+		for range 2 {
+			err := <-results
+			require.True(t, err == nil || errors.Is(err, ErrTransactionCanceled), "%v", err)
+		}
+		responses := connection.snapshot()
+		finals := 0
+		for _, response := range responses {
+			require.Equal(t, "dialog-tag", responseTag(response))
+			if response.CSeq().MethodName == INVITE && response.StatusCode >= 200 {
+				finals++
+			}
+		}
+		require.Equal(t, 1, finals, "only cancellation or application final can win")
+		tx.Terminate()
+	}
+}
+
+func TestServerTxCancelDoesNotRewriteForwardedTags(t *testing.T) {
+	layer, tx, request, connection := cancelIdentityFixture(t)
+	first := taggedResponse(request, 200, "fork-a")
+	second := taggedResponse(request, 200, "fork-b")
+	require.NoError(t, tx.Respond(first))
+	require.NoError(t, tx.Respond(second))
+	require.NoError(t, layer.handleRequest(matchingCancel(request)))
+	responses := connection.snapshot()
+	require.Equal(t, "fork-a", responseTag(responses[0]))
+	require.Equal(t, "fork-b", responseTag(responses[1]))
+	require.Equal(t, "fork-b", responseTag(responses[2]))
+	require.Equal(t, "fork-a", responseTag(first))
+	require.Equal(t, "fork-b", responseTag(second))
+}
